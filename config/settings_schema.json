        "id": "brand_name",
        "label": "t:editor.brand_name",
        "default": "Bloome"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:editor.logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "t:editor.logo_width",
        "default": 150,
        "min": 60,
        "max": 300,
        "step": 5,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:editor.favicon"
      }
    ]
  },
  {

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% if settings.favicon != blank %}<link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% endif %}
    {{ content_for_header }}
  </head>

  <body data-motion="{% if settings.enable_animations %}on{% else %}off{% endif %}" data-button-style="{{ settings.button_style | default: 'solid' }}">
    <a class="skip-link" href="#MainContent">{{ 'bloome.skip' | t }}</a>
    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">{{ content_for_layout }}</main>

    {% sections 'footer-group' %}
  </body>
</html>

<div
  class="bl-announcement full-width"
  style="--bar-bg:{{ section.settings.background }};--bar-fg:{{ section.settings.foreground }}"
>
  {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif -%}
  {{- section.settings.text | escape -}}
  {%- if section.settings.link != blank %}</a>{% endif %}
</div>
{% stylesheet %}

  .bl-announcement {
    background: var(--bar-bg);
    color: var(--bar-fg);
    text-align: center;
    padding: 10px 20px;
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .bl-announcement a {
    display: block;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.announcement.name",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:library.announcement.text",
      "default": "A little ritual. A little radiance. A whole lot of you."
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:library.announcement.link"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:library.announcement.background",
      "default": "#49323f"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "t:library.announcement.foreground",
      "default": "#fff8eb"
    }
  ],
  "presets": [
    {
      "name": "t:library.announcement.name"
    }
  ]
}
{% endschema %}

{% render 'section-settings', section: section, default_heading: 84, default_mobile_heading: 58 %}
<section class="beauty-hero" style="--hero-bg:{{ section.settings.background }};--hero-height:{{ section.settings.desktop_height }}px;--hero-mobile-height:{{ section.settings.mobile_height }}px">
  <div class="hero-copy">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>
      {{ section.settings.heading | escape }}
      <em>{{ section.settings.accent | escape }}</em>
    </h1>
    <p class="hero-description">{{ section.settings.description | escape }}</p>
    <a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
      {{- section.settings.button | escape }}
      <span aria-hidden="true">&#8599;</span></a
    >
    <p class="hero-footnote">&#10035; &nbsp; {{ section.settings.footnote | escape }}</p>
  </div>
  <div class="hero-art">
    {% if section.settings.image -%}
      {{-
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          widths: '480, 760, 1100, 1600',
          sizes: '(min-width:760px) 55vw, 100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'hero-photo'
      -}}
    {%- else %}
      {% render 'photo-fallback', index: 2, image_class: 'hero-photo', loading: 'eager', priority: 'high' %}
    {% endif -%}
    <span class="hero-caption">{{ section.settings.caption | escape }}</span
    ><span class="round-note">
      {{- section.settings.note | escape -}}
      <span aria-hidden="true">&#8599;</span></span
    >
  </div>
</section>
<div class="beauty-strip full-width">
  <span>{{ 'bloome.skin_first' | t }}</span><span aria-hidden="true">&#10035;</span
  ><span>{{ 'bloome.colour' | t }}</span><span aria-hidden="true">&#10035;</span
  ><span>{{ 'bloome.everyday' | t }}</span><span aria-hidden="true">&#10035;</span
  ><span>{{ 'bloome.your_terms' | t }}</span>
</div>
{% stylesheet %}
.beauty-hero{display:grid;grid-template-columns:1fr 1.05fr;background:var(--hero-bg);overflow:hidden;margin-bottom:45px}.hero-copy{padding:64px 30px 40px 52px;position:relative;z-index:1}.hero-copy h1{font-size:clamp(55px,6.3vw,94px);line-height:1.01;letter-spacing:-.065em;font-weight:400;max-width:560px}.hero-copy h1 em{font-family:Georgia,serif;font-weight:400;color:var(--color-accent)}.hero-description{font-size:14px;line-height:1.8;max-width:290px;margin:26px 0 30px}.hero-footnote{font-size:10px;margin-top:40px}.hero-art{position:relative;background:radial-gradient(ellipse at 60% 40%,#e4bfa4,#d6b7a0 70%);overflow:hidden;display:flex;justify-content:center;align-items:center}.hero-photo{position:absolute;width:100%;height:100%;object-fit:cover}.hero-orbit{width:430px;height:430px;border:1px solid #f8ead57a;border-radius:50%;position:absolute;top:25px;left:8%}.hero-plinth{position:absolute;width:85%;height:180px;background:linear-gradient(150deg,#eacdb2,#b9957b);border-radius:50% 50% 0 0;bottom:-70px;transform:rotate(-8deg)}.hero-bottle{z-index:2;transform:scale(1.32) translate(-35px,-8px)}.hero-jar{position:absolute;z-index:3;transform:scale(1.12) rotate(3deg);bottom:104px;right:42px}.hero-spark{position:absolute;top:42px;right:35px;font-size:80px;color:#fff4df}.hero-caption{position:absolute;bottom:28px;left:28px;z-index:4;font-size:9px;text-transform:uppercase;letter-spacing:.12em}.round-note{position:absolute;top:35px;left:20px;width:95px;height:95px;background:#e9e9ce;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;font-size:11px;padding:12px;z-index:3;transform:rotate(-15deg)}.round-note span{font-size:24px}.beauty-strip{display:flex;justify-content:space-evenly;align-items:center;gap:var(--grid-gap,20px);border-block:1px solid var(--color-border);padding:19px 20px;font-size:11px;text-transform:uppercase;letter-spacing:.1em}.beauty-strip span:nth-child(even){font-size:22px;color:#8b5e6c}.beauty-hero,.hero-art{min-height:var(--hero-height,570px)}
@media(max-width:760px){.beauty-hero,.hero-art{min-height:var(--hero-mobile-height,440px)}.beauty-hero{grid-template-columns:1fr;margin-bottom:28px}.hero-copy{padding:40px 25px}.hero-copy h1{font-size:64px}.hero-bottle{transform:scale(1.15) translate(-30px,-8px)}.hero-jar{bottom:80px;right:35px}.beauty-strip{flex-wrap:wrap;font-size:9px;gap:12px}.beauty-strip span:last-child{display:none}.hero-footnote{margin-top:25px}}
{% endstylesheet %}
{% schema %}
{
  "name": "t:bloome.section_2.name",
  "settings": [
    {
      "type": "header",
      "content": "t:slider.layout"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "t:slider.desktop_height",
      "min": 400,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 570
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "t:slider.mobile_height",
      "min": 320,
      "max": 800,
      "step": 10,
      "unit": "px",
      "default": 440
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:bloome.section_2.eyebrow",
      "default": "Meet your new feel-good ritual"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:bloome.section_2.heading",
      "default": "Good skin."
    },
    {
      "type": "text",
      "id": "accent",
      "label": "t:bloome.section_2.accent",
      "default": "Great energy."
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:bloome.section_2.description",
      "default": "Skin-loving essentials. Mood-lifting makeup. A little everyday magic, made for you."
    },
    {
      "type": "text",
      "id": "button",
      "label": "t:bloome.section_2.button",
      "default": "Find your glow"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:bloome.section_2.link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:bloome.section_2.image"
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:bloome.section_2.background",
      "default": "#EEE9DD"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:bloome.section_2.footnote",
      "default": "Your skin. Your pace. Your kind of beautiful."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "t:bloome.section_2.caption",
      "default": "The everyday essentials / 01"
    },
    {
      "type": "text",
      "id": "note",
      "label": "t:bloome.section_2.note",
      "default": "A new start for your shelf"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 84,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 58,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 0,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 0,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:bloome.section_2.name"
    }
  ]
}
{% endschema %}

{% render 'section-settings', section: section %}
<section class="beauty-products" id="skincare">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    <a
      class="text-link"
      href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}"
    >
      {{- 'bloome.shop_all' | t }} &#8599;</a
    >
  </div>
  <div class="beauty-product-grid">
    {% for card_product in section.settings.collection.products limit: 4 -%}
      {%- render 'beauty-card', card_product: card_product, index: forloop.index -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        {%- render 'beauty-card', index: i -%}
      {%- endfor -%}
    {%- endfor %}
  </div>
</section>
{% stylesheet %}
.beauty-products{padding:70px 0 80px}.section-heading{display:flex;justify-content:space-between;align-items:end;gap:var(--grid-gap,20px);margin-bottom:32px}.section-heading .eyebrow{margin-bottom:12px}.section-heading h2{font-size:clamp(32px,3.5vw,48px);font-weight:400;letter-spacing:-.05em}@media(max-width:760px){.beauty-products{padding:45px 0}.section-heading h2{font-size:32px}}
{% endstylesheet %}
{% schema %}
{
  "name": "t:bloome.section_3.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:bloome.section_3.eyebrow",
      "default": "The shelf essentials"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:bloome.section_3.heading",
      "default": "Your daily dose of good."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:bloome.section_3.collection"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "t:editor.section_gap",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:bloome.section_3.name"
    }
  ]
}
{% endschema %}

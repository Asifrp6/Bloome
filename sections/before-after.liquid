{% render 'section-settings', section: section %}
<div class="bl-section bl-component-before-after">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading -%}
  <bloome-compare>
    <div class="bl-compare" style="--position:50%">
      <div class="bl-before">
        {% render 'library-media', image: section.settings.before, kind: 'serum' -%}
        <span>{{ section.settings.before_label | escape }}</span>
      </div>
      <div class="bl-after">
        {% render 'library-media', image: section.settings.after, kind: 'cream' -%}
        <span>{{ section.settings.after_label | escape }}</span>
      </div>
      <div class="bl-compare-line" aria-hidden="true">&#8596;</div>
      <label class="visually-hidden" for="Compare-{{ section.id }}">{{ 'library.compare' | t }}</label
      ><input
        id="Compare-{{ section.id }}"
        type="range"
        min="0"
        max="100"
        value="50"
        aria-valuetext="{{ 'library.comparison_initial' | t }}"
      >
    </div>
  </bloome-compare>
  <div class="bl-rte bl-comparison-note">{{ section.settings.text }}</div>
</div>
{% stylesheet %}

  .bl-compare {
    position: relative;
    aspect-ratio: 1.65;
    overflow: hidden;
    isolation: isolate;
  }
  .bl-before,
  .bl-after {
    position: absolute;
    inset: 0;
  }
  .bl-compare .bl-media {
    height: 100%;
    aspect-ratio: auto;
  }
  .bl-after {
    clip-path: inset(0 0 0 var(--position));
    background: #e8dce0;
  }
  .bl-after .bl-media {
    background: #e8dce0;
  }
  .bl-before > span,
  .bl-after > span {
    position: absolute;
    bottom: 20px;
    padding: 10px 16px;
    background: #fff8eb;
    font-size: 12px;
  }
  .bl-before > span {
    left: 20px;
  }
  .bl-after > span {
    right: 20px;
  }
  .bl-compare-line {
    position: absolute;
    left: var(--position);
    top: 0;
    bottom: 0;
    border-left: 2px solid #fff8eb;
    display: grid;
    place-items: center;
    color:var(--color-foreground);
    font-size: 26px;
    pointer-events: none;
  }
  .bl-compare input[type='range'] {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    padding: 0;
  }
  .bl-compare:focus-within {
    outline: 3px solid var(--color-accent);
    outline-offset: 4px;
  }
  .bl-comparison-note {
    margin-top: 18px;
    font-size: 12px;
  }
  @media (max-width: 760px) {
    .bl-compare {
      aspect-ratio: 1;
    }
  }

{% endstylesheet %}
{% javascript %}
  class BloomeCompare extends HTMLElement {
    connectedCallback() {
      if (this.ready) return;
      this.ready = true;
      const input = this.querySelector('input');
      input.addEventListener('input', () => {
        this.querySelector('.bl-compare').style.setProperty('--position', input.value + '%');
        input.setAttribute('aria-valuetext', input.value + '%');
      });
    }
  }
  if (!customElements.get('bloome-compare')) customElements.define('bloome-compare', BloomeCompare);
{% endjavascript %}
{% schema %}

{% render 'section-settings', section: section %}
<div class="bl-section bl-component-bundle-builder">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading -%}
  <bloome-bundle
    data-add-url="{{ routes.cart_add_url }}.js"
    data-cart-url="{{ routes.cart_url }}"
    data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
    data-locale="{{ request.locale.iso_code }}"
    data-max="{{ section.settings.maximum }}"
    data-error="{{ 'library.bundle_error' | t }}"
  >
    <div class="bl-bundle-layout">
      <div class="bl-bundle-summary">
        <div class="bl-rte">{{ section.settings.text }}</div>
        <p>
          {{ 'library.selected' | t }}
          <strong data-count>0</strong> / {{ section.settings.maximum }}
        </p>
        <p>
          {{ 'bloome.subtotal' | t }}
          <strong data-total>{{ 0 | money }}</strong>
        </p>
        <button class="button" data-add type="button" disabled>{{ 'library.add_bundle' | t }} &#8599;</button>
        <p class="bl-muted">{{ 'library.bundle_pricing' | t }}</p>
        <p data-error role="alert"></p>
      </div>
      <div class="bl-grid" style="--columns:2;--mobile-columns:2">
        {% for block in section.blocks %}
          <article class="bl-bundle-card" {{ block.shopify_attributes }}>
            {% assign bundle_product = block.settings.product -%}
            {%- render 'library-media', image: bundle_product.featured_image -%}
            {%- if bundle_product != blank %}
              <h3>
                <a href="{{ bundle_product.url }}">{{ bundle_product.title | escape }}</a>
              </h3>
              <label class="visually-hidden" for="BundleVariant-{{ section.id }}-{{ block.id }}">
                {{- 'bloome.variant' | t -}}</label
              ><select id="BundleVariant-{{ section.id }}-{{ block.id }}" data-variant>
                {% paginate bundle_product.variants by 250 %}
                  {% assign bundle_offsets = '0,50,100,150,200' | split: ',' %}
                  {% for bundle_offset in bundle_offsets %}
                    {% assign bundle_offset_number = bundle_offset | plus: 0 %}
                    {% for variant in bundle_product.variants offset: bundle_offset_number limit: 50 %}
                      {% render 'bundle-variant-option', variant: variant, product: bundle_product %}
                    {% endfor %}
                  {% endfor %}
                {% endpaginate %}</select
              ><label class="bl-bundle-check"
                ><input
                  type="checkbox"
                  data-pick
                  {% unless bundle_product.available %}
                    data-unavailable="true" disabled
                  {% endunless %}
                >
                {{- 'library.include_bundle' | t -}}
              </label>
            {%- else %}
              <h3>{{ block.settings.title | escape }}</h3>
              <p class="bl-muted">{{ 'bloome.preview' | t }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </bloome-bundle>
</div>
{% stylesheet %}

  .bl-bundle-layout {
    display: grid;
    grid-template-columns: 0.7fr 1.5fr;
    gap: 45px;
  }
  .bl-bundle-summary {
    padding: 35px;
    background: var(--color-surface);
    align-self: start;
    position: sticky;
    top: 100px;
  }
  .bl-bundle-summary > p {
    margin: 20px 0;
    font-size: 14px;
  }
  .bl-bundle-summary > p.bl-muted {
    font-size: 11px;
  }
  .bl-bundle-summary [data-error] {
    color: #8a263a;
  }
  .bl-bundle-card h3 {
    font-size: 15px;
    font-weight: 500;
    margin: 18px 0 12px;
  }
  .bl-bundle-card select {
    width: 100%;
    font-size: 11px;
  }
  .bl-bundle-check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    margin-top: 15px;
    min-height: 44px;
  }
  .bl-bundle-check input {
    width: 18px;
    height: 18px;
  }
  @media (max-width: 760px) {
    .bl-bundle-layout {
      grid-template-columns: 1fr;
      gap: 25px;
    }
    .bl-bundle-summary {
      position: static;
      padding: 25px;
    }
  }

{% endstylesheet %}
{% javascript %}
  class BloomeBundle extends HTMLElement {
    connectedCallback() {
      if (this.ready) return;
      this.ready = true;
      this.limit = Number(this.dataset.max);
      this.busy = false;
      try {
        this.money = new Intl.NumberFormat(this.dataset.locale || 'en', {
          style: 'currency',
          currency: this.dataset.currency || 'USD',
        });
      } catch {
        this.money = new Intl.NumberFormat('en', { style: 'currency', currency: 'USD' });
      }
      this.addEventListener('change', () => this.update());
      this.querySelector('[data-add]').addEventListener('click', () => this.add());
      this.update();
    }
    selected() {
      return [...this.querySelectorAll('.bl-bundle-card')].filter(
        (card) => card.querySelector('[data-pick]')?.checked,
      );
    }
    update() {
      const selected = this.selected();
      this.querySelector('[data-count]').textContent = selected.length;
      const total = selected.reduce(
        (sum, card) => sum + Number(card.querySelector('select').selectedOptions[0].dataset.price),
        0,
      );
      this.querySelector('[data-total]').textContent = this.money.format(total / 100);
      this.querySelectorAll('[data-pick]').forEach((input) => {
        input.disabled =
          input.closest('article').querySelector('select').options.length === 0 ||
          (!input.checked && selected.length >= this.limit) ||
          input.dataset.unavailable === 'true';
      });
      this.querySelector('[data-add]').disabled = this.busy || selected.length === 0;
    }
    async add() {
      if (this.busy || !this.selected().length) return;
      const error = this.querySelector('[data-error]');
      error.textContent = '';
      this.busy = true;
      this.update();
      const quantities = new Map();
      for (const card of this.selected()) {
        const id = Number(card.querySelector('select').value);
        quantities.set(id, (quantities.get(id) || 0) + 1);
      }
      try {
        const response = await fetch(this.dataset.addUrl, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({ items: [...quantities].map(([id, quantity]) => ({ id, quantity })) }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.description || result.message || this.dataset.error);
        window.location.assign(this.dataset.cartUrl);
      } catch (e) {
        error.textContent = e.message || this.dataset.error;
        this.busy = false;
        this.update();
      }
    }
  }
  if (!customElements.get('bloome-bundle')) customElements.define('bloome-bundle', BloomeBundle);
{% endjavascript %}
{% schema %}
{
  "name": "t:library.bundle_builder.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.bundle_builder.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.bundle_builder.heading",
      "default": "Your ritual. Your own combination."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:library.bundle_builder.text",
      "default": "<p>Choose the essentials that belong in your daily ritual.</p>"
    },
    {
      "type": "range",
      "id": "maximum",
      "label": "t:library.bundle_builder.maximum",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {

{% render 'section-settings', section: section %}
<div class="beauty-cart">
  <h1>{{ 'cart.title' | t }}</h1>
  {% if cart.item_count == 0 %}
    <p>{{ 'bloome.empty' | t }}</p>
    <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'bloome.shop_all' | t }} &#8599;</a>
  {%- else %}
    {% assign cart_form_id = 'CartForm-' | append: section.id %}{% form 'cart', cart, id: cart_form_id %}
      {% for item in cart.items %}
        <div class="cart-line">
          {% if item.image -%}
            <a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy' }}</a>
          {%- endif %}
          <div>
            <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
            <p>{{ item.variant.title | escape }}</p>
            {% if item.original_price > item.final_price %}<del>{{ item.original_price | money }}</del>{% endif %}<span>{{ item.final_price | money }}</span>{% if item.unit_price_measurement %}<span class="unit-price">{{ item.unit_price | unit_price_with_measurement: item.unit_price_measurement }}</span>{% endif %}
            <p>{{ item.final_line_price | money }}</p>
            {% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
            {% for property in item.properties %}{% assign property_initial = property.first | slice:0 %}{% unless property_initial == '_' %}{% if property.last != blank %}<p>{{ property.first | escape }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last }}">{{ property.last | split:'/' | last | escape }}</a>{% else %}{{ property.last | escape }}{% endif %}</p>{% endif %}{% endunless %}{% endfor %}
            {% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }}: -{{ discount.amount | money }}</p>{% endfor %}
            <a class="text-link" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
          </div>
          <div>
            <label for="CartQuantity-{{ section.id }}-{{ forloop.index }}">{{ 'bloome.quantity' | t }}</label
            ><input
              id="CartQuantity-{{ section.id }}-{{ forloop.index }}"
              type="number"
              name="updates[]"
              min="0"
              value="{{ item.quantity }}"
            >
          </div>
        </div>
      {% endfor %}
      {% if section.settings.show_notes %}<div class="cart-note"><label for="CartNote-{{ section.id }}">{{ 'editor.order_note' | t }}</label><textarea id="CartNote-{{ section.id }}" name="note" rows="3">{{ cart.note | escape }}</textarea></div>{% endif %}<div class="cart-summary">{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: -{{ discount.total_allocated_amount | money }}</p>{% endfor %}<p class="bl-muted">{{ 'editor.shipping_note' | t }}</p>
        <p>{{ 'bloome.subtotal' | t }}: {{ cart.total_price | money }}</p>
        <button class="button" type="submit">{{ 'cart.update' | t }}</button
        ><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }} &#8599;</button>
      </div>
      {% if cart.taxes_included %}<p>{{ 'editor.taxes_included' | t }}</p>{% endif %}
      {% if additional_checkout_buttons %}<div class="cart-accelerated">{{ content_for_additional_checkout_buttons }}</div>{% endif %}
    {% endform %}
  {% endif %}
</div>
{% stylesheet %}
.cart-note{display:grid;gap:12px;margin-top:25px;font-size:13px}.cart-note textarea{width:100%}

.beauty-cart{max-width:900px;width:100%;margin:20px auto 60px}.beauty-cart h1{font-size:56px;margin-bottom:35px}.beauty-cart>p{margin-bottom:25px}.cart-line{display:grid;grid-template-columns:110px 1fr auto;gap:25px;align-items:center;padding:25px 0;border-bottom:1px solid var(--color-border);font-size:14px}.cart-line img{width:110px;aspect-ratio:1;object-fit:cover}.cart-line p{margin:8px 0;font-size:12px}.cart-line label{display:block;font-size:11px;margin-bottom:8px}.cart-line input{width:75px}.cart-summary{text-align:right;display:flex;justify-content:end;align-items:center;gap:var(--grid-gap,20px);flex-wrap:wrap;padding-top:30px}@media(max-width:500px){.cart-line{grid-template-columns:65px 1fr 65px;gap:12px}.cart-line img{width:65px}.cart-line input{width:60px}.cart-summary{gap:12px}}
{% endstylesheet %}
{% schema %}
{
  "name": "t:bloome.section_7.name",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_notes",
      "label": "t:editor.show_notes",
      "default": true
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ]
}
{% endschema %}

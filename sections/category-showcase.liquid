        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:library.category_showcase.b0_text",
          "default": "<p>A curated collection for your everyday ritual.</p>"
        },
        {
          "type": "text",
          "id": "button",
          "label": "t:library.category_showcase.b0_button",
          "default": "Shop this edit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:library.category_showcase.b0_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:library.category_showcase.name",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Morning rituals",
            "heading": "Start your day in Bloome."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Evening essentials",
            "heading": "Make space for your reset."
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Weekend colour",
            "heading": "Follow your mood."
          }
        }
      ]
    }
  ]
}
{% endschema %}

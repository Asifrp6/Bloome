{% render 'section-settings', section: section %}
<div class="bl-section bl-component-collection-list">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div
    class="bl-grid bl-collections bl-collections--{{ section.settings.shape }}"
    style="--columns:{{ section.settings.columns }};--mobile-columns:{{ section.settings.mobile_columns }}"
  >
    {% for block in section.blocks -%}
      {%- assign item_collection = block.settings.collection -%}
      {%- assign item_image = block.settings.image | default: item_collection.featured_image -%}
      <a
        class="bl-tile"
        href="{{ block.settings.link | default: item_collection.url | default: routes.all_products_collection_url }}"
        {{ block.shopify_attributes }}
      >
        {%- render 'library-media', image: item_image, index: forloop.index %}
        <h3>{{ block.settings.title | default: item_collection.title | escape }}</h3>
        {% if item_collection %}
          <p>{{ 'library.product_count' | t: count: item_collection.products_count }}</p>
        {% endif -%}
      </a>
    {%- endfor %}
  </div>
</div>
{% stylesheet %}

  .bl-collections--circle .bl-media {
    width: min(100%, 210px);
    margin-inline: auto;
    border-radius: 50%;
  }
  .bl-collections {
    text-align: center;
    gap: 28px;
  }
  .bl-collections h3 {
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .bl-collections .bl-tile > p {
    opacity: 0.65;
  }
  .bl-collections .bl-media .beauty-object {
    scale: 0.6;
  }

{% endstylesheet %}
{% schema %}
{

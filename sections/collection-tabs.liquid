{% render 'section-settings', section: section %}
<div class="bl-section bl-component-collection-tabs">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading -%}
  <bloome-tabs>
    <div class="bl-tabs" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {% for block in section.blocks -%}
        <button
          type="button"
          role="tab"
          id="Tab-{{ section.id }}-{{ block.id }}"
          aria-controls="Panel-{{ section.id }}-{{ block.id }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
        >
          {{ block.settings.title | escape }}
        </button>
      {%- endfor %}
    </div>
    {% for block in section.blocks %}
      <div
        class="bl-panel"
        id="Panel-{{ section.id }}-{{ block.id }}"
        role="tabpanel"
        aria-labelledby="Tab-{{ section.id }}-{{ block.id }}"
        tabindex="0"
        {% unless forloop.first %}
          hidden
        {% endunless %}
        {{ block.shopify_attributes }}
      >
        <div class="bl-products">
          {% for card_product in block.settings.collection.products limit: section.settings.limit -%}
            {%- render 'beauty-card', card_product: card_product, index: forloop.index -%}
          {%- else -%}
            {%- for i in (1..4) -%}
              {%- render 'beauty-card', index: i -%}
            {%- endfor -%}
          {%- endfor %}
        </div>
      </div>
    {% endfor -%}
  </bloome-tabs>
</div>

{% schema %}
{
  "name": "t:library.collection_tabs.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.collection_tabs.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.collection_tabs.heading",
      "default": "The essentials, your way."
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:library.collection_tabs.limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "t:editor.section_gap",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "collection",
      "name": "t:library.collection_tabs.block_0",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:library.collection_tabs.b0_title",
          "default": "The daily edit"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:library.collection_tabs.b0_collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:library.collection_tabs.name",
      "blocks": [
        {
          "type": "collection",
          "settings": {
            "title": "Bestsellers"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "Skincare"
          }
        },
        {
          "type": "collection",
          "settings": {
            "title": "New arrivals"
          }
        }
      ]
    }
  ]
}
{% endschema %}

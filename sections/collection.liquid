{% render 'section-settings', section: section %}
<div class="bl-section">
  <div class="bl-collection-layout {% unless section.settings.show_filters %}bl-collection-layout--full{% endunless %}" style="--collection-columns:{{ section.settings.desktop_columns }}">
    {% if section.settings.show_filters %}<aside>
      <form action="{{ collection.url }}" method="get" class="bl-filters">
        <h2>{{ 'library.filters' | t }}</h2>
        {% for filter in collection.filters %}
          <details open>
            <summary>{{ filter.label | escape }}</summary>
            {% case filter.type -%}
              {%- when 'list', 'boolean' -%}
                {%- for value in filter.values -%}
                  <label class="bl-filter-check"
                    ><input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value | escape }}"
                      {% if value.active %}
                        checked
                      {% endif %}
                      {% if value.count == 0 %}
                        {%- unless value.active %}disabled{% endunless -%}
                      {% endif %}
                    >
                    {{- value.label | escape }} ({{ value.count }})</label
                  >
                {%- endfor -%}
              {%- when 'price_range' -%}
                <label for="FilterMin-{{ section.id }}">{{ 'library.minimum_price' | t }}</label
                ><input
                  id="FilterMin-{{ section.id }}"
                  name="{{ filter.min_value.param_name }}"
                  type="number"
                  min="0"
                  step="0.01"
                  {% if filter.min_value.value %}
                    value="{{ filter.min_value.value | divided_by:100.0 }}"
                  {% endif %}

                ><label for="FilterMax-{{ section.id }}">{{ 'library.maximum_price' | t }}</label
                ><input
                  id="FilterMax-{{ section.id }}"
                  name="{{ filter.max_value.param_name }}"
                  type="number"
                  min="0"
                  step="0.01"
                  {% if filter.max_value.value %}
                    value="{{ filter.max_value.value | divided_by:100.0 }}"
                  {% endif %}
                >
            {%- endcase %}
          </details>
        {% endfor -%}
        <label for="Sort-{{ section.id }}">{{ 'library.sort_by' | t }}</label
        ><select id="Sort-{{ section.id }}" name="sort_by">
          {% assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
          {%- for option in collection.sort_options %}
            <option
              value="{{ option.value }}"
              {% if option.value == current_sort %}
                selected
              {% endif %}
            >
              {{ option.name | escape }}
            </option>
          {% endfor %}</select
        ><button type="submit" class="button">{{ 'library.apply_filters' | t }}</button
        ><a class="text-link" href="{{ collection.url }}">{{ 'library.clear_filters' | t }}</a>
      </form>
    </aside>{% endif %}
    <div>
      <div class="bl-active-filters">
        {% for filter in collection.filters -%}
          {%- for value in filter.active_values -%}
            <a href="{{ value.url_to_remove }}">{{ value.label | escape }} &#10005;</a>
          {%- endfor -%}
        {%- endfor %}
      </div>
      {% paginate collection.products by section.settings.products_per_page %}
        <p class="bl-muted">{{ 'library.product_count' | t: count: collection.products_count }}</p>
        <div class="beauty-product-grid">
          {% for card_product in collection.products -%}
            {%- assign card_index = forloop.index0 | modulo: 4 | plus: 1 -%}
            {%- render 'beauty-card', card_product: card_product, index: card_index -%}
          {%- else %}
            <p>{{ 'bloome.no_products' | t }}</p>
          {% endfor %}
        </div>
        <div class="collection-pagination">{{ paginate | default_pagination }}</div>
      {% endpaginate %}
    </div>
  </div>
</div>
{% render 'library-heading' %}
{% stylesheet %}
.bl-collection-layout--full{grid-template-columns:minmax(0,1fr)}.bl-collection-layout .beauty-product-grid{grid-template-columns:repeat(var(--collection-columns,4),minmax(0,1fr))}@media(max-width:760px){.bl-collection-layout .beauty-product-grid{grid-template-columns:repeat(var(--mobile-product-columns,2),minmax(0,1fr))}}


  .bl-collection-layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr);
    gap: 35px;
  }
  .bl-filters {
    display: grid;
    gap: 18px;
    font-size: 12px;
  }
  .bl-filters h2 {
    font-size: 22px;
    font-weight: 400;
  }
  .bl-filters details {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 15px;
  }
  .bl-filters summary {
    font-size: 14px;
    cursor: pointer;
    padding: 10px 0;
  }
  .bl-filters label {
    display: block;
    margin-top: 12px;
  }
  .bl-filters .bl-filter-check {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .bl-filters input[type='checkbox'] {
    width: 16px;
    height: 16px;
  }
  .bl-filters input[type='number'],
  .bl-filters select {
    width: 100%;
    min-width: 0;
  }
  .bl-filters .button {
    font-size: 11px;
    gap: 10px;
  }
  .bl-active-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 20px;
    font-size: 11px;
  }
  .bl-active-filters a {
    padding: 8px;
    background: var(--color-surface);
  }
  .bl-collection-layout .beauty-product-grid {
    margin-top: 20px;
  }
  .collection-pagination {
    display: flex;
    gap: 15px;
    padding: 35px 0;
  }
  .bl-collection-layout > div {
    min-width: 0;
  }
  @media (max-width: 760px) {
    .bl-collection-layout {
      grid-template-columns: 1fr;
    }
    .bl-filters {
      grid-template-columns: 1fr 1fr;
      gap: 15px;
    }
    .bl-filters h2 {
      grid-column: 1/-1;
    }
    .bl-filters details {
      min-width: 0;
    }
    .bl-filters select {
      align-self: end;
    }
  }

{% endstylesheet %}
{% schema %}

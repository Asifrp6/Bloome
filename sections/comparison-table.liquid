{% render 'section-settings', section: section %}
<div class="bl-section bl-component-comparison-table">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-table-wrap">
    <table class="bl-comparison-table">
      <caption class="visually-hidden">
        {{ section.settings.heading | escape }}
      </caption>
      <thead>
        <tr>
          <th scope="col">{{ section.settings.feature_label | escape }}</th>
          <th scope="col">{{ section.settings.first_label | escape }}</th>
          <th scope="col">{{ section.settings.second_label | escape }}</th>
        </tr>
      </thead>
      <tbody>
        {% for block in section.blocks %}
          <tr {{ block.shopify_attributes }}>
            <th scope="row">{{ block.settings.title | escape }}</th>
            <td>{{ block.settings.first | escape }}</td>
            <td>{{ block.settings.second | escape }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% stylesheet %}

  .bl-table-wrap {
    overflow-x: auto;
  }
  .bl-comparison-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 450px;
    text-align: left;
    font-size: 14px;
  }
  .bl-comparison-table th,
  .bl-comparison-table td {
    padding: 22px;
    border-bottom: 1px solid var(--color-border);
  }
  .bl-comparison-table th {
    font-weight: 500;
  }
  .bl-comparison-table thead {
    background: #eee5e0;
  }
  .bl-comparison-table td:nth-child(2) {
    background: #f0eae4;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.comparison_table.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.comparison_table.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.comparison_table.heading",
      "default": "Find your favourite finish."
    },
    {
      "type": "text",
      "id": "feature_label",
      "label": "t:library.comparison_table.feature_label",
      "default": "The details"
    },
    {
      "type": "text",
      "id": "first_label",
      "label": "t:library.comparison_table.first_label",
      "default": "The daily ritual"
    },
    {
      "type": "text",
      "id": "second_label",
      "label": "t:library.comparison_table.second_label",
      "default": "The evening ritual"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "row",
      "name": "t:library.comparison_table.block_0",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:library.comparison_table.b0_title",
          "default": "Texture"
        },
        {
          "type": "text",
          "id": "first",
          "label": "t:library.comparison_table.b0_first",
          "default": "Light and soft"
        },
        {
          "type": "text",
          "id": "second",
          "label": "t:library.comparison_table.b0_second",
          "default": "Rich and comforting"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:library.comparison_table.name",
      "blocks": [
        {
          "type": "row",
          "settings": {
            "title": "Texture",
            "first": "Lightweight",
            "second": "Rich"
          }
        },
        {
          "type": "row",
          "settings": {
            "title": "Finish",
            "first": "Soft",
            "second": "Soft"
          }
        },
        {
          "type": "row",
          "settings": {
            "title": "Your moment",
            "first": "Morning",
            "second": "Evening"
          }
        }
      ]
    }
  ]
}
{% endschema %}

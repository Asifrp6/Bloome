{% render 'section-settings', section: section %}
<div class="bl-section bl-component-contact-form">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-contact">
    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <p role="status">{{ 'library.message_sent' | t }}</p>
      {% endif -%}
      {{- form.errors | default_errors -}}
      <label for="ContactName-{{ section.id }}">{{ 'library.name' | t }}</label
      ><input
        id="ContactName-{{ section.id }}"
        name="contact[name]"
        autocomplete="name"
        value="{{ form.name | default: customer.name | escape }}"
        required

      ><label for="ContactEmail-{{ section.id }}">{{ 'bloome.email' | t }}</label
      ><input
        id="ContactEmail-{{ section.id }}"
        type="email"
        name="contact[email]"
        autocomplete="email"
        value="{{ form.email | default: customer.email | escape }}"
        required

      ><label for="ContactBody-{{ section.id }}">{{ 'library.message' | t }}</label
      >><textarea
        id="ContactBody-{{ section.id }}"
        name="contact[body]"
        rows="6"
        required
      >{{ form.body | escape }}</textarea
      ><button class="button" type="submit">{{ 'library.send_message' | t }} &#8599;</button>
    {% endform %}
  </div>
</div>
{% stylesheet %}

  .bl-contact {
    max-width: 750px;
  }
  .bl-contact form {
    display: grid;
    gap: 12px;
  }
  .bl-contact label {
    font-size: 12px;
    margin-top: 10px;
  }
  .bl-contact .button {
    justify-self: start;
    margin-top: 15px;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.contact_form.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.contact_form.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.contact_form.heading",
      "default": "We would love to hear from you."
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:library.contact_form.name"
    }
  ]
}
{% endschema %}

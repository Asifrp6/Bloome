    {
      "type": "text",
      "id": "heading",
      "label": "t:library.content_with_video.heading",
      "default": "Made for your daily glow."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:library.content_with_video.text",
      "default": "<p>Discover the textures and little details behind your everyday essentials.</p>"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:library.content_with_video.video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:library.content_with_video.image"
    },

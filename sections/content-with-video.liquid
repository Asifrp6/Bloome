{% render 'section-settings', section: section %}
<div class="bl-section bl-component-content-with-video">
  {% render 'library-heading', eyebrow:section.settings.eyebrow, heading:section.settings.heading %}
  <bloome-product-preview class="bl-split">
    <div class="bl-copy">
      <div class="bl-rte">{{ section.settings.text }}</div>
      <div class="bl-mini-products">
        {% for block in section.blocks %}
          {% assign preview_image = block.settings.image | default:block.settings.product.featured_image %}
          {% assign preview_title = block.settings.product.title | default:block.settings.title %}
          {% if section.settings.enable_product_preview %}
            <button type="button" class="bl-product-selector" data-preview-target="ProductPreview-{{ section.id }}-{{ block.id }}" aria-controls="ProductPreview-{{ section.id }}-{{ block.id }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
              {% render 'library-media', image:preview_image, index:forloop.index %}<span>{{ preview_title | escape }}</span>
            </button>
          {% else %}
            <a href="{{ block.settings.product.url | default:routes.all_products_collection_url }}" {{ block.shopify_attributes }}>{% render 'library-media', image:preview_image, index:forloop.index %}<span>{{ preview_title | escape }}</span></a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    <div class="bl-content-video" aria-live="polite">
      {% if section.settings.enable_product_preview %}
        {% for block in section.blocks %}
          {% assign preview_image = block.settings.image | default:block.settings.product.featured_image %}
          {% assign preview_title = block.settings.product.title | default:block.settings.title %}
          <div id="ProductPreview-{{ section.id }}-{{ block.id }}" class="bl-product-preview-panel" data-preview-panel {% unless forloop.first %}hidden{% endunless %}>
            {% if block.settings.product != blank %}<a class="bl-product-preview-link" href="{{ block.settings.product.url }}" aria-label="{{ 'product_preview.open' | t: product:preview_title | escape }}">{% render 'library-media', image:preview_image, index:forloop.index %}<span class="visually-hidden">{{ preview_title | escape }}</span></a>
            {% else %}{% render 'library-media', image:preview_image, index:forloop.index %}{% endif %}
          </div>
        {% else %}{% render 'library-media', image:section.settings.image %}{% endfor %}
      {% elsif section.settings.video != blank %}
        {{ section.settings.video | video_tag:controls:true,preload:'none',image_size:'1200x',playsinline:true }}
      {% else %}{% render 'library-media', image:section.settings.image %}{% endif %}
    </div>
  </bloome-product-preview>
</div>
{% stylesheet %}
  .bl-mini-products{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:25px}
  .bl-mini-products .bl-media{aspect-ratio:1}.bl-mini-products .beauty-object{scale:.35}.bl-mini-products span{font-size:10px;display:block;margin-top:10px}
  .bl-product-selector{display:block;width:100%;min-width:0;padding:0;border:0;background:transparent;color:inherit;text-align:left;cursor:pointer}.bl-product-selector .bl-media{outline:2px solid transparent;outline-offset:-2px}.bl-product-selector[aria-pressed=true] .bl-media{outline-color:var(--color-accent)}.bl-product-selector:hover .bl-media{filter:brightness(.97)}
  .bl-content-video{min-width:0}.bl-content-video>video{width:100%;aspect-ratio:1;object-fit:cover}.bl-product-preview-link{display:block}.bl-product-preview-panel>.bl-media,.bl-product-preview-link>.bl-media{aspect-ratio:1;grid-template-rows:minmax(0,1fr)}.bl-product-preview-panel:not([hidden]){animation:bloome-product-preview-enter .2s ease}
  @keyframes bloome-product-preview-enter{from{opacity:.25}to{opacity:1}}
  @media(prefers-reduced-motion:reduce){.bl-product-preview-panel:not([hidden]){animation:none}}
{% endstylesheet %}
{% javascript %}
class BloomeProductPreview extends HTMLElement{
  connectedCallback(){if(this.ready)return;this.ready=true;this.addEventListener('click',event=>{const selector=event.target.closest('[data-preview-target]');if(selector&&this.contains(selector))this.select(selector);});this.addEventListener('keydown',event=>{const selector=event.target.closest('[data-preview-target]');if(!selector)return;const selectors=[...this.querySelectorAll('[data-preview-target]')];let index=selectors.indexOf(selector);if(event.key==='ArrowRight')index=(index+1)%selectors.length;else if(event.key==='ArrowLeft')index=(index-1+selectors.length)%selectors.length;else if(event.key==='Home')index=0;else if(event.key==='End')index=selectors.length-1;else return;event.preventDefault();this.select(selectors[index]);selectors[index].focus();});this.addEventListener('shopify:block:select',event=>{const selector=event.target.closest('[data-preview-target]');if(selector)this.select(selector);});}
  select(selector){const panel=this.querySelector('[id="'+selector.dataset.previewTarget+'"]');if(!panel)return;this.querySelectorAll('[data-preview-target]').forEach(node=>node.setAttribute('aria-pressed',String(node===selector)));this.querySelectorAll('[data-preview-panel]').forEach(node=>node.hidden=node!==panel);}
}
if(!customElements.get('bloome-product-preview'))customElements.define('bloome-product-preview',BloomeProductPreview);
{% endjavascript %}
{% schema %}
{

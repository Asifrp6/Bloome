{% render 'section-settings', section: section %}
<div class="bl-section bl-component-countdown-banner">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-countdown-banner">
    <div>
      <h3>{{ section.settings.title | escape }}</h3>
      <div class="bl-rte">{{ section.settings.text }}</div>
      {% if section.settings.button != blank -%}
        <a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{- section.settings.button | escape }}
          <span aria-hidden="true">&#8599;</span></a
        >
      {%- endif %}
    </div>
    <bloome-countdown data-end="{{ section.settings.end | escape }}">
      <div class="bl-countdown" role="timer" aria-label="{{ 'library.time_remaining' | t }}">
        <div>
          <strong data-days>00</strong><span>{{ 'library.days' | t }}</span>
        </div>
        <div>
          <strong data-hours>00</strong><span>{{ 'library.hours' | t }}</span>
        </div>
        <div>
          <strong data-minutes>00</strong><span>{{ 'library.minutes' | t }}</span>
        </div>
        <div>
          <strong data-seconds>00</strong><span>{{ 'library.seconds' | t }}</span>
        </div>
      </div>
      <p data-expired hidden>{{ section.settings.expired | escape }}</p>
    </bloome-countdown>
  </div>
</div>
{% stylesheet %}

  .bl-countdown-banner {
    background: #49323f;
    color: #fff8eb;
    padding: 45px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 35px;
    align-items: center;
  }
  .bl-countdown-banner h3 {
    font-size: 34px;
    font-weight: 400;
    letter-spacing: -0.04em;
    margin-bottom: 15px;
  }
  .bl-countdown-banner .button {
    
    
    margin-top: 20px;
  }
  .bl-countdown {
    display: flex;
    justify-content: center;
    gap: 24px;
  }
  .bl-countdown strong {
    display: block;
    font-size: 44px;
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  .bl-countdown span {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .bl-countdown-banner [data-expired] {
    font-size: 24px;
    text-align: center;
  }
  @media (max-width: 760px) {
    .bl-countdown-banner {
      grid-template-columns: 1fr;
      padding: 28px;
    }
    .bl-countdown {
      gap: 18px;
    }
    .bl-countdown strong {
      font-size: 36px;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:library.countdown_banner.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.countdown_banner.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.countdown_banner.heading",
      "default": "Something good is coming."
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:library.countdown_banner.title",
      "default": "Your next favourite, soon."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:library.countdown_banner.text",
      "default": "<p>A new chapter in your daily ritual.</p>"
    },
    {
      "type": "text",
      "id": "end",
      "label": "t:library.countdown_banner.end"
    },
    {
      "type": "text",
      "id": "expired",
      "label": "t:library.countdown_banner.expired",
      "default": "Discover what is new."
    },
    {
      "type": "text",
      "id": "button",
      "label": "t:library.countdown_banner.button",
      "default": "Explore the edit"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:library.countdown_banner.link"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:library.countdown_banner.name"
    }
  ]
}
{% endschema %}

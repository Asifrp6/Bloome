{% render 'section-settings', section: section %}
<div class="bl-section bl-component-countdown-collection">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-countdown-collection">
    <div class="bl-deal-intro">
      <h3>{{ section.settings.title | escape }}</h3>
      <div class="bl-rte">{{ section.settings.text }}</div>
      <bloome-countdown data-end="{{ section.settings.end | escape }}">
        <div class="bl-countdown" role="timer" aria-label="{{ 'library.time_remaining' | t }}">
          <div>
            <strong data-days>00</strong><span>{{ 'library.days' | t }}</span>
          </div>
          <div>
            <strong data-hours>00</strong><span>{{ 'library.hours' | t }}</span>
          </div>
          <div>
            <strong data-minutes>00</strong><span>{{ 'library.minutes' | t }}</span>
          </div>
          <div>
            <strong data-seconds>00</strong><span>{{ 'library.seconds' | t }}</span>
          </div>
        </div>
        <p data-expired hidden>{{ section.settings.expired | escape }}</p>
      </bloome-countdown>
    </div>
    <div class="bl-deal-products">
      {% for card_product in section.settings.collection.products limit: 4 -%}
        {%- render 'beauty-card', card_product: card_product, index: forloop.index -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {%- render 'beauty-card', index: i -%}
        {%- endfor -%}
      {%- endfor %}
    </div>
  </div>
</div>
{% stylesheet %}

  .bl-countdown-collection {
    display: grid;
    grid-template-columns: 0.8fr 1.6fr;
    gap: 35px;
    background: var(--color-surface);
    padding: 35px;
  }
  .bl-deal-intro {
    align-self: center;
  }
  .bl-deal-intro h3 {
    font-size: 35px;
    font-weight: 400;
    letter-spacing: -0.04em;
    margin-bottom: 22px;
  }
  .bl-deal-products {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px 15px;
  }
  .bl-deal-intro .bl-countdown {
    display: flex;
    gap: 15px;
    margin-top: 25px;
  }
  .bl-deal-intro .bl-countdown strong {
    display: block;
    font-size: 30px;
    font-weight: 400;
  }
  .bl-deal-intro .bl-countdown span {
    font-size: 9px;
  }
  .bl-deal-intro [data-expired] {
    margin-top: 25px;
    font-size: 12px;
  }
  @media (max-width: 760px) {
    .bl-countdown-collection {
      grid-template-columns: 1fr;
      padding: 22px;
    }
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.countdown_collection.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.countdown_collection.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.countdown_collection.heading",
      "default": "An edit worth making time for."
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:library.countdown_collection.title",
      "default": "Your next daily favourite."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:library.countdown_collection.text",
      "default": "<p>Discover the latest edit of everyday essentials.</p>"
    },
    {
      "type": "text",
      "id": "end",
      "label": "t:library.countdown_collection.end"
    },
    {
      "type": "text",
      "id": "expired",
      "label": "t:library.countdown_collection.expired",
      "default": "Explore the latest collection."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:library.countdown_collection.collection"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:library.countdown_collection.name"
    }
  ]
}
{% endschema %}

{% render 'section-settings', section: section %}
<div class="bl-section bl-component-faq">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-faq">
    {% for block in section.blocks %}
      <details
        {{ block.shopify_attributes }}
        {% if forloop.first %}
          open
        {% endif %}
      >
        <summary>
          {{ block.settings.question | escape -}}
          <span aria-hidden="true">+</span>
        </summary>
        <div class="bl-rte">{{ block.settings.answer }}</div>
      </details>
    {% endfor %}
  </div>
</div>
{% stylesheet %}

  .bl-faq {
    max-width: 900px;
  }
  .bl-faq details {
    border-bottom: 1px solid var(--color-border);
  }
  .bl-faq summary {
    display: flex;
    justify-content: space-between;
    gap: 25px;
    padding: 22px 0;
    cursor: pointer;
    list-style: none;
    font-size: 17px;
  }
  .bl-faq summary > span {
    font-size: 24px;
  }
  .bl-faq details[open] summary > span {
    transform: rotate(45deg);
  }
  .bl-faq .bl-rte {
    padding: 0 40px 24px 0;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.faq.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.faq.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.faq.heading",
      "default": "A little more clarity."
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "question",
      "name": "t:library.faq.block_0",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:library.faq.b0_question",
          "default": "How do I find my daily essentials?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:library.faq.b0_answer",
          "default": "<p>Browse our skincare and makeup edits to discover textures and finishes that fit your routine.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:library.faq.name",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "Where should I start?",
            "answer": "<p>Explore the skincare and makeup edits to find your daily essentials.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "Where can I find product details?",
            "answer": "<p>Each product page includes its description and available options.</p>"
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "How can I contact you?",
            "answer": "<p>Use our contact page to send a question to our team.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}#shopify-section-{{ section.id }} .beauty-footer{padding-block:{{ section.settings.footer_padding }}px}#shopify-section-{{ section.id }} .footer-top h2{font-size:{{ section.settings.footer_heading_size }}px}{% endstyle %}
<footer class="beauty-footer full-width">
  {% if section.settings.show_newsletter %}<div class="footer-top">
    <div>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape }}</h2>
    </div>
    {% assign newsletter_form_id = 'NewsletterForm-' | append: section.id %}
{% form 'customer', id: newsletter_form_id, class: 'newsletter'  %}
      <input type="hidden" name="contact[tags]" value="newsletter"
      ><label class="visually-hidden" for="Newsletter-{{ section.id }}">{{ 'bloome.email' | t }}</label>
      <div class="newsletter-field">
        <input
          id="Newsletter-{{ section.id }}"
          type="email"
          name="contact[email]"
          placeholder="{{ 'bloome.email' | t }}"
          autocomplete="email"
          required

        ><button type="submit" aria-label="{{ 'bloome.subscribe' | t }}">&#8599;</button>
      </div>
      {% if form.posted_successfully? %}
        <p role="status">{{ 'bloome.subscribed' | t }}</p>
      {% endif -%}
      {{- form.errors | default_errors }}
      <p>{{ 'bloome.newsletter_note' | t }}</p>
    {% endform %}
  </div>
  {% endif %}<div class="footer-bottom">
    <a class="wordmark" href="{{ routes.root_url }}">{% render 'brand-logo', brand: section.settings.brand, image: section.settings.logo %}</a>
    <nav aria-label="{{ 'bloome.footer_navigation' | t }}">
      {% for link in section.settings.menu.links -%}
        <a href="{{ link.url }}">{{ link.title | escape }}</a>
      {%- endfor -%}
      {%- for policy in shop.policies -%}
        {%- if policy.body != blank -%}
          <a href="{{ policy.url }}">{{ policy.title | escape }}</a>
        {%- endif -%}
      {%- endfor %}
    </nav>
    <small
      >&copy; {{ 'now' | date: '%Y' }}
      {{ shop.name | escape -}}
    </small>
  </div>
<div class="footer-extra"><nav aria-label="{{ 'editor.social_links' | t }}">{% if settings.social_instagram != blank %}<a href="{{ settings.social_instagram }}">Instagram</a>{% endif %}{% if settings.social_tiktok != blank %}<a href="{{ settings.social_tiktok }}">TikTok</a>{% endif %}{% if settings.social_facebook != blank %}<a href="{{ settings.social_facebook }}">Facebook</a>{% endif %}{% if settings.social_youtube != blank %}<a href="{{ settings.social_youtube }}">YouTube</a>{% endif %}</nav>{% if section.settings.show_payment_icons %}<div class="footer-payment">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag }}{% endfor %}</div>{% endif %}</div>{% assign localization_id = 'Localization-' | append: section.id %}{% render 'localization', id: localization_id %}{% if shop.features.follow_on_shop? %}<div class="footer-follow">{{ shop | login_button: action: 'follow' }}</div>{% endif %}</footer>
{% stylesheet %}
.footer-extra{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding-top:25px}.footer-extra nav,.footer-payment{display:flex;gap:15px;flex-wrap:wrap;font-size:12px}.footer-payment svg{width:38px;height:24px}

.beauty-footer{background:var(--color-surface);padding:48px max(25px,calc((100vw - 1280px)/2))}.footer-top{display:flex;justify-content:space-between;align-items:center;gap:40px;padding-bottom:50px;border-bottom:1px solid var(--color-border)}.footer-top h2{font-size:36px;letter-spacing:-.05em;font-weight:400}.footer-top .eyebrow{margin-bottom:14px}.newsletter{width:380px;max-width:100%}.newsletter-field{display:flex;border-bottom:1px solid #76616c}.newsletter-field input{border:0;background:transparent;width:100%;padding:15px 0;font-size:12px}.newsletter-field button{border:0;background:none;font-size:25px;width:48px;cursor:pointer;color:inherit}.newsletter>p{font-size:10px;line-height:1.6;margin-top:12px}.footer-bottom{display:flex;align-items:center;justify-content:space-between;gap:30px;padding-top:35px}.footer-bottom nav{display:flex;gap:var(--grid-gap,20px);flex-wrap:wrap;font-size:11px}.footer-bottom small{font-size:10px}@media(max-width:760px){.footer-top,.footer-bottom{flex-direction:column;align-items:start;gap:28px}.newsletter{width:100%}.beauty-footer{padding:40px 22px}.footer-top h2{font-size:30px}}
{% endstylesheet %}
{% schema %}
{
  "name": "t:bloome.section_1.name",
  "settings": [
    {
      "type": "text",
      "id": "brand",
      "label": "t:editor.brand_override"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:bloome.section_1.eyebrow",
      "default": "The good things, in your inbox"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:bloome.section_1.heading",
      "default": "Let's stay in bloome."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:bloome.section_1.menu",
      "default": "footer"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "t:editor.logo_override"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:editor.show_newsletter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:editor.show_payment_icons",
      "default": true
    },
    {
      "type": "range",
      "id": "footer_heading_size",
      "label": "t:editor.footer_heading_size",
      "default": 36,
      "min": 24,
      "max": 56,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "footer_padding",
      "label": "t:editor.footer_padding",
      "default": 48,
      "min": 20,
      "max": 80,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:bloome.section_1.name"
    }
  ]
}
{% endschema %}

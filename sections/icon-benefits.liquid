{% render 'section-settings', section: section %}
<div class="bl-section bl-component-icon-benefits">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-grid bl-benefits" style="--columns:{{ section.settings.columns }};--mobile-columns:2">
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        {% if block.settings.image != blank -%}
          {{- block.settings.image | image_url: width: 120 | image_tag: loading: 'lazy' -}}
        {%- else -%}
          <span aria-hidden="true">&#10035;</span>
        {%- endif %}
        <h3>{{ block.settings.title | escape }}</h3>
        <p>{{ block.settings.text | escape }}</p>
      </div>
    {% endfor %}
  </div>
</div>
{% stylesheet %}

  .bl-benefits {
    text-align: center;
    border-block: 1px solid var(--color-border);
    padding: 30px 0;
  }
  .bl-benefits span {
    display: block;
    font-size: 40px;
    margin-bottom: 15px;
  }
  .bl-benefits img {
    width: 45px;
    height: 45px;
    object-fit: contain;
    margin: 0 auto 15px;
  }
  .bl-benefits h3 {
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 9px;
  }
  .bl-benefits p {
    font-size: 12px;
    line-height: 1.6;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.icon_benefits.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.icon_benefits.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.icon_benefits.heading",
      "default": "The little things matter."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:library.icon_benefits.columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",

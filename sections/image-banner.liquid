{% render 'section-settings', section: section %}
<div class="bl-section bl-component-image-banner">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-banner" style="--overlay:{{ section.settings.overlay | divided_by: 100.0 }}">
    {% render 'library-media', image: section.settings.image %}
    <div class="bl-banner-copy">
      <h3>{{ section.settings.title | escape }}</h3>
      <div class="bl-rte">{{ section.settings.text }}</div>
      {% if section.settings.button != blank -%}
        <a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{- section.settings.button | escape }}
          <span aria-hidden="true">&#8599;</span></a
        >
      {%- endif %}
    </div>
  </div>
</div>
{% stylesheet %}

  .bl-banner {
    position: relative;
    min-height: 460px;
    display: grid;
    place-items: center;
    isolation: isolate;
  }
  .bl-banner > .bl-media {
    position: absolute;
    inset: 0;
    aspect-ratio: auto;
    z-index: -2;
  }
  .bl-banner:after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(35 16 29 / var(--overlay));
    z-index: -1;
  }
  .bl-banner-copy {
    text-align: center;
    color: #fff8eb;
    padding: 50px;
    max-width: 700px;
  }
  .bl-banner-copy h3 {
    font-family: Georgia, serif;
    font-size: clamp(38px, 5vw, 72px);
    font-weight: 400;
    margin-bottom: 20px;
  }
  .bl-banner-copy .button {
    margin-top: 25px;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.image_banner.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.image_banner.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.image_banner.heading",
      "default": "The new-season edit."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:library.image_banner.image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:library.image_banner.title",
      "default": "More room for radiance."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:library.image_banner.text",
      "default": "<p>Beautiful textures. Favourite rituals. A new perspective.</p>"
    },
    {
      "type": "text",
      "id": "button",
      "label": "t:library.image_banner.button",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:library.image_banner.link"
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "t:library.image_banner.overlay",
      "min": 0,
      "max": 90,
      "step": 1,
      "default": 40,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:library.image_banner.name"
    }
  ]
}
{% endschema %}

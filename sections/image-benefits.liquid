{% render 'section-settings', section: section %}
<div class="bl-section bl-component-image-benefits">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-image-benefits">
    <div class="bl-benefit-list">
      {% for block in section.blocks limit: 2 %}
        <div {{ block.shopify_attributes }}>
          <span aria-hidden="true">&#10035;</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <div class="bl-rte">{{ block.settings.text }}</div>
        </div>
      {% endfor %}
    </div>
    {% render 'library-media', image: section.settings.image %}
    <div class="bl-benefit-list">
      {% for block in section.blocks offset: 2 %}
        <div {{ block.shopify_attributes }}>
          <span aria-hidden="true">&#10035;</span>
          <h3>{{ block.settings.title | escape }}</h3>
          <div class="bl-rte">{{ block.settings.text }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{% stylesheet %}

  .bl-image-benefits {
    display: grid;
    grid-template-columns: 1fr 1.1fr 1fr;
    gap: 35px;
    align-items: center;
  }
  .bl-image-benefits > .bl-media {
    border-radius: 50% 50% 10px 10px;
    aspect-ratio: 0.8;
  }
  .bl-benefit-list {
    display: grid;
    gap: 35px;
  }
  .bl-benefit-list > div > span {
    font-size: 27px;
  }
  .bl-benefit-list h3 {
    font-size: 20px;
    font-weight: 400;
    margin: 12px 0;
  }
  .bl-benefit-list .bl-rte {
    font-size: 12px;
  }
  @media (max-width: 760px) {
    .bl-image-benefits {
      grid-template-columns: 1fr;
    }
    .bl-image-benefits > .bl-media {
      order: -1;
      max-width: 330px;
      width: 100%;
      margin: auto;
    }
    .bl-benefit-list {
      grid-template-columns: 1fr 1fr;
      gap:var(--grid-gap,20px);
    }
  }

{% endstylesheet %}
{% schema %}
{

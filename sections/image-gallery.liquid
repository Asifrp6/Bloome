{% render 'section-settings', section: section %}
<div class="bl-section bl-component-image-gallery">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div
    class="bl-grid bl-gallery bl-gallery--{{ section.settings.layout }}"
    style="--columns:{{ section.settings.columns }};--mobile-columns:2"
  >
    {% for block in section.blocks %}
      <figure {{ block.shopify_attributes }}>
        {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif -%}
        {%- render 'library-media', image: block.settings.image, index: forloop.index -%}
        {%- if block.settings.link != blank %}</a>{% endif %}
        <figcaption>{{ block.settings.caption | escape }}</figcaption>
      </figure>
    {% endfor %}
  </div>
</div>
{% stylesheet %}

  .bl-gallery figure {
    margin: 0;
  }
  .bl-gallery figcaption {
    font-size: 12px;
    margin-top: 12px;
  }
  .bl-gallery--editorial > figure:first-child {
    grid-row: span 2;
  }
  .bl-gallery--editorial > figure:first-child .bl-media {
    aspect-ratio: 0.7;
  }
  @media (max-width: 760px) {
    .bl-gallery--editorial > figure:first-child {
      grid-row: auto;
      grid-column: span 2;
    }
    .bl-gallery--editorial > figure:first-child .bl-media {
      aspect-ratio: 1.2;
    }
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.image_gallery.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.image_gallery.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.image_gallery.heading",
      "default": "A world of little discoveries."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:library.image_gallery.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:library.image_gallery.layout",
      "options": [
        {
          "value": "grid",
          "label": "t:library.image_gallery.layout_0"
        },
        {
          "value": "editorial",
          "label": "t:library.image_gallery.layout_1"
        }
      ],
      "default": "editorial"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "t:editor.section_gap",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "image",
      "name": "t:library.image_gallery.block_0",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:library.image_gallery.b0_image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:library.image_gallery.b0_caption",
          "default": "Your everyday edit"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:library.image_gallery.b0_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:library.image_gallery.name",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "caption": "Soft starts"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "A daily favourite"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "Your finishing touch"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% render 'section-settings', section: section %}
<div class="bl-section ingredient-lab" style="grid-column:1 / -1;width:min(90rem,calc(100% - 40px));max-width:none;justify-self:center">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  {% if section.blocks.size == 0 %}
    <p class="bl-muted">{{ 'ingredient_lab.empty' | t }}</p>
  {% else %}
    {% liquid
      assign ingredient_label = section.settings.heading
      if ingredient_label == blank
        assign ingredient_label = 'ingredient_lab.label' | t
      endif
    %}
    <bloome-tabs class="ingredient-stage">
      <div class="ingredient-mosaic" role="tablist" aria-label="{{ ingredient_label | escape }}">
        {% for block in section.blocks %}
          <button type="button" class="ingredient-tile" role="tab" id="IngredientTab-{{ section.id }}-{{ block.id }}" aria-controls="IngredientPanel-{{ section.id }}-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}">
            <span class="ingredient-photo">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 900 | image_tag: widths: '240, 480, 900', sizes: '(min-width: 1000px) 18vw, 70vw', loading: 'lazy', alt: '' }}
              {% else %}
                {% render 'photo-fallback', index: forloop.index %}
              {% endif %}
            </span>
            <span class="ingredient-caption">
              <span class="ingredient-name">{{ block.settings.title | escape }}</span>
              {% if block.settings.note != blank %}<span class="ingredient-note">{{ block.settings.note | escape }}</span>{% endif %}
            </span>
          </button>
        {% endfor %}
      </div>
      {% for block in section.blocks %}
        {% assign ingredient_url = block.settings.collection.url | default: routes.all_products_collection_url %}
        <article class="ingredient-panel" id="IngredientPanel-{{ section.id }}-{{ block.id }}" role="tabpanel" aria-labelledby="IngredientTab-{{ section.id }}-{{ block.id }}" {% unless forloop.first %}hidden{% endunless %} {{ block.shopify_attributes }}>
          <div class="ingredient-story">
            <h3>{{ block.settings.title | escape }}</h3>
            {% if block.settings.note != blank %}<p class="ingredient-lead">{{ block.settings.note | escape }}</p>{% endif %}
            {% if block.settings.text != blank %}<div class="bl-rte">{{ block.settings.text }}</div>{% endif %}
            {% if block.settings.button != blank %}<a class="button" href="{{ ingredient_url }}">{{ block.settings.button | escape }}</a>{% endif %}
          </div>
        </article>
      {% endfor %}
    </bloome-tabs>
  {% endif %}
</div>
{% stylesheet %}
.ingredient-lab > .bl-heading { margin-bottom: 22px; }
.ingredient-lab > .bl-heading h2 { max-width: 16em; line-height: 1.05; }
.ingredient-stage { display: grid; gap: 16px; }
.ingredient-mosaic { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
.ingredient-tile { position: relative; display: block; min-height: 280px; padding: 0; border: 0; border-radius: 24px; overflow: hidden; background: #c9b4b8; color: #fff; text-align: left; box-shadow: inset 0 0 0 1px #ffffff33; }
.ingredient-photo { position: absolute; inset: 0; }
.ingredient-photo img { display: block; width: 100%; height: 100%; object-fit: cover; }
.ingredient-tile::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 38%, #2b1c24d9 100%); pointer-events: none; }
.ingredient-caption { position: relative; z-index: 1; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; min-height: 280px; padding: 16px; }
.ingredient-name { font-size: 18px; letter-spacing: -0.04em; line-height: 1.15; }
.ingredient-note { font-size: 13px; line-height: 1.4; color: #ffffffd6; }
.ingredient-tile[aria-selected="true"] { box-shadow: inset 0 0 0 3px #fff, 0 0 0 2px var(--color-foreground); }
.ingredient-panel { display: flex; align-items: flex-end; justify-content: space-between; gap: 28px; padding: 6px 4px 0; background: transparent; }
.ingredient-story { display: flex; flex-direction: column; justify-content: center; max-width: 640px; padding: 0; }
.ingredient-story h3 { max-width: 16em; overflow-wrap: normal; word-break: normal; hyphens: none; font-size: clamp(28px, 3vw, 40px); font-weight: 500; letter-spacing: -0.045em; line-height: 1.08; margin-bottom: 8px; }
.ingredient-lead { font-size: 16px; line-height: 1.45; margin-bottom: 8px; }
.ingredient-story .bl-rte { max-width: 46em; line-height: 1.65; }
.ingredient-story .button { align-self: flex-start; margin-top: 16px; min-height: 48px; padding: 12px 22px; border-radius: 999px; }
.ingredient-panel:not([hidden]) .ingredient-story { animation: ingredient-enter 0.35s ease both; }
@keyframes ingredient-enter { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
@media (max-width: 1000px) {
  .ingredient-mosaic { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 760px) {
  .ingredient-mosaic { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; }
  .ingredient-tile { flex: 0 0 72%; scroll-snap-align: start; min-height: 320px; }
  .ingredient-caption { min-height: 320px; }
  .ingredient-panel { flex-direction: column; align-items: flex-start; }
}
@media (prefers-reduced-motion: reduce) {
  .ingredient-panel:not([hidden]) .ingredient-story { animation: none; }
}
{% endstylesheet %}
{% schema %}
{
  "name": "t:library.ingredient_lab.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:library.ingredient_lab.eyebrow", "default": "In plain words" },
    { "type": "text", "id": "heading", "label": "t:library.ingredient_lab.heading", "default": "Meet the ingredients." },
    { "type": "header", "content": "t:editor.section_design" },
    { "type": "color_scheme", "id": "section_color_scheme", "label": "t:editor.section_color_scheme", "default": "scheme-1" },
    { "type": "select", "id": "content_width", "label": "t:editor.content_width", "default": "page", "options": [
      { "value": "page", "label": "t:editor.content_width_0" },
      { "value": "narrow", "label": "t:editor.content_width_1" },
      { "value": "full", "label": "t:editor.content_width_2" }
    ]},
    { "type": "select", "id": "text_alignment", "label": "t:editor.text_alignment", "default": "left", "options": [
      { "value": "left", "label": "t:editor.text_alignment_0" },
      { "value": "center", "label": "t:editor.text_alignment_1" },
      { "value": "right", "label": "t:editor.text_alignment_2" }
    ]},
    { "type": "checkbox", "id": "custom_typography", "label": "t:editor.custom_typography", "default": false },
    { "type": "range", "id": "heading_size", "label": "t:editor.heading_size", "default": 46, "min": 24, "max": 100, "step": 1, "unit": "px", "visible_if": "{{ section.settings.custom_typography }}" },
    { "type": "range", "id": "heading_mobile_size", "label": "t:editor.heading_mobile_size", "default": 34, "min": 22, "max": 72, "step": 1, "unit": "px", "visible_if": "{{ section.settings.custom_typography }}" },
    { "type": "range", "id": "text_size", "label": "t:editor.text_size", "default": 14, "min": 12, "max": 22, "step": 1, "unit": "px", "visible_if": "{{ section.settings.custom_typography }}" },
    { "type": "range", "id": "image_radius", "label": "t:editor.image_radius", "default": 0, "min": 0, "max": 40, "step": 1, "unit": "px" },
    { "type": "range", "id": "section_gap", "label": "t:editor.section_gap", "default": 12, "min": 0, "max": 40, "step": 1, "unit": "px" },
    { "type": "header", "content": "t:editor.section_spacing" },
    { "type": "range", "id": "padding_top", "label": "t:editor.padding_top", "default": 20, "min": 0, "max": 100, "step": 1, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "t:editor.padding_bottom", "default": 50, "min": 0, "max": 100, "step": 1, "unit": "px" },
    { "type": "range", "id": "padding_mobile_top", "label": "t:editor.padding_mobile_top", "default": 12, "min": 0, "max": 80, "step": 1, "unit": "px" },
    { "type": "range", "id": "padding_mobile_bottom", "label": "t:editor.padding_mobile_bottom", "default": 30, "min": 0, "max": 80, "step": 1, "unit": "px" },
    { "type": "header", "content": "t:editor.section_visibility" },
    { "type": "checkbox", "id": "hide_desktop", "label": "t:editor.hide_desktop", "default": false },
    { "type": "checkbox", "id": "hide_mobile", "label": "t:editor.hide_mobile", "default": false }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "t:library.ingredient_lab.block_0",
      "settings": [
        { "type": "text", "id": "title", "label": "t:library.ingredient_lab.b0_title", "default": "Hyaluronic acid" },
        { "type": "text", "id": "note", "label": "t:library.ingredient_lab.b0_note", "default": "Helps skin feel cushioned." },
        { "type": "richtext", "id": "text", "label": "t:library.ingredient_lab.b0_text", "default": "<p>A water-loving ingredient people look for when skin feels dry or tight.</p>" },
        { "type": "text", "id": "button", "label": "t:library.ingredient_lab.b0_button", "default": "Shop this ingredient" },
        { "type": "collection", "id": "collection", "label": "t:library.ingredient_lab.b0_collection" },
        { "type": "image_picker", "id": "image", "label": "t:library.ingredient_lab.b0_image" }
      ]
    }
  ],
  "max_blocks": 6,
  "disabled_on": { "groups": ["header", "footer"] },
  "presets": [
    {
      "name": "t:library.ingredient_lab.name",
      "blocks": [
        { "type": "ingredient", "settings": { "title": "Hyaluronic acid", "note": "Helps skin feel cushioned.", "text": "<p>A water-loving ingredient people look for when skin feels dry or tight.</p>", "button": "Shop hydration" } },
        { "type": "ingredient", "settings": { "title": "Niacinamide", "note": "A familiar smoothing active.", "text": "<p>Often chosen for a more even look and a comfortable daily routine.</p>", "button": "Shop niacinamide" } },
        { "type": "ingredient", "settings": { "title": "Vitamin C", "note": "A bright daytime favorite.", "text": "<p>A well-known antioxidant for mornings when skin looks a little tired.</p>", "button": "Shop vitamin C" } },
        { "type": "ingredient", "settings": { "title": "Peptides", "note": "Soft support for a firmer look.", "text": "<p>A quiet ingredient for people building a longer-term ritual.</p>", "button": "Shop peptides" } },
        { "type": "ingredient", "settings": { "title": "Ceramides", "note": "Comfort for the skin barrier.", "text": "<p>Often used when skin wants to feel calmer and less easily unsettled.</p>", "button": "Shop ceramides" } }
      ]
    }
  ]
}
{% endschema %}

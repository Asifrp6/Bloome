{% render 'section-settings', section: section %}
<div class="bl-section bl-component-logo-list">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-grid bl-logos" style="--columns:{{ section.settings.columns }};--mobile-columns:2">
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        {% if block.settings.image -%}
          {{-
            block.settings.image
            | image_url: width: 400
            | image_tag: loading: 'lazy', widths: '200, 400', sizes: '200px'
          -}}
        {%- else -%}
          <span>{{ block.settings.title | escape }}</span>
        {%- endif -%}
        {%- if block.settings.text != blank %}
          <p>{{ block.settings.text | escape }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
{% stylesheet %}

  .bl-logos {
    text-align: center;
    align-items: center;
  }
  .bl-logos > div {
    padding: 25px 15px;
  }
  .bl-logos img {
    max-height: 70px;
    max-width: 180px;
    margin: auto;
    object-fit: contain;
  }
  .bl-logos span {
    font-family: Georgia, serif;
    font-size: 25px;
  }
  .bl-logos p {
    font-size: 11px;
    margin-top: 12px;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.logo_list.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.logo_list.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.logo_list.heading",
      "default": "In good company."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:library.logo_list.columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "t:editor.section_gap",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "logo",
      "name": "t:library.logo_list.block_0",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:library.logo_list.b0_image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:library.logo_list.b0_title",
          "default": "Your partner"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:library.logo_list.b0_text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:library.logo_list.name",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "title": "Your brand here"
          }
        },
        {
          "type": "logo",
          "settings": {
            "title": "Your partner here"
          }
        },
        {
          "type": "logo",
          "settings": {
            "title": "Your publication here"
          }
        },
        {
          "type": "logo",
          "settings": {
            "title": "Your community here"
          }
        }
      ]
    }
  ]
}
{% endschema %}

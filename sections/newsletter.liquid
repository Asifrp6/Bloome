{% render 'section-settings', section: section %}
<div class="bl-section bl-component-newsletter">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-newsletter">
    <div class="bl-rte">{{ section.settings.text }}</div>
    {% assign newsletter_form_id = 'NewsletterForm-' | append: section.id %}
{% form 'customer', id: newsletter_form_id %}
      <input type="hidden" name="contact[tags]" value="newsletter"
      ><label for="Email-{{ section.id }}">{{ 'bloome.email' | t }}</label>
      <div>
        <input id="Email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required
        ><button type="submit" class="button">{{ 'bloome.subscribe' | t }} &#8599;</button>
      </div>
      {% if form.posted_successfully? %}
        <p role="status">{{ 'bloome.subscribed' | t }}</p>
      {% endif -%}
      {{- form.errors | default_errors }}
    {% endform %}
    <p class="bl-muted">{{ 'bloome.newsletter_note' | t }}</p>
  </div>
</div>
{% stylesheet %}

  .bl-newsletter {
    max-width: 700px;
  }
  .bl-newsletter form {
    margin: 24px 0 16px;
  }
  .bl-newsletter label {
    display: block;
    font-size: 12px;
    margin-bottom: 10px;
  }
  .bl-newsletter form > div {
    display: flex;
    gap: 12px;
  }
  .bl-newsletter input[type='email'] {
    flex: 1;
    min-width: 0;
  }
  .bl-newsletter form > p {
    margin-top: 15px;
  }
  @media (max-width: 500px) {
    .bl-newsletter form > div {
      flex-direction: column;
    }
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.newsletter.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.newsletter.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.newsletter.heading",
      "default": "A little good in your inbox."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:library.newsletter.text",
      "default": "<p>New discoveries, beauty notes and a little inspiration for your day.</p>"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:library.newsletter.name"
    }
  ]
}
{% endschema %}

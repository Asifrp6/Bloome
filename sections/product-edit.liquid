{% render 'section-settings', section: section %}
<section class="bl-section product-edit" style="--edit-columns:{{ section.settings.columns }};--edit-mobile-columns:{{ section.settings.columns_mobile }};--edit-radius:{{ section.settings.card_radius }}px;--edit-background:{{ section.settings.card_background }};--edit-foreground:{{ section.settings.card_foreground }};--edit-action:{{ section.settings.action_background }};--edit-action-label:{{ section.settings.action_foreground }}">
  {% render 'library-heading', eyebrow:section.settings.eyebrow, heading:section.settings.heading %}
  {% assign edit_products = section.settings.products | default:section.settings.collection.products | default:collection.products %}
  <div class="product-edit-grid">
    {% for item in edit_products limit:section.settings.product_limit %}{% render 'product-edit-card', item:item, index:forloop.index, section:section %}
    {% else %}{% for index in (1..4) %}{% render 'product-edit-card', index:index, section:section %}{% endfor %}{% endfor %}
  </div>
</section>
{% stylesheet %}
  .product-edit-grid{display:grid;grid-template-columns:repeat(var(--edit-columns,4),minmax(0,1fr));gap:var(--grid-gap,20px);align-items:stretch}
  .edit-card{display:flex;flex-direction:column;min-width:0;overflow:hidden;border-radius:var(--edit-radius,20px);background:var(--edit-background,#faf3f5);color:var(--edit-foreground,#650d33);padding-bottom:22px}
  .edit-card-media{position:relative;aspect-ratio:1;overflow:hidden}.edit-card-media>a{display:grid;width:100%;height:100%}.edit-card-image{width:100%;height:100%;object-fit:contain}.edit-card-media .beauty-object{scale:.68}
  .edit-badge{position:absolute;top:15px;left:15px;padding:5px 11px;border-radius:999px;background:#772247;color:white;font-size:11px;font-weight:600;text-transform:uppercase}.edit-badge--sale{background:#ff508b}
  .edit-card-body{display:flex;align-items:start;justify-content:space-between;gap:12px;padding:16px 22px 0}.edit-card-information{min-width:0;flex:1}.edit-card h3{font:inherit;font-size:18px;line-height:1.4;font-weight:400;margin:0 0 4px}.edit-card h3 a:hover{text-decoration:underline}.edit-card-price{font-size:14px;line-height:1.5}.edit-card-price .card-price{font-size:inherit}.edit-card-price del{font-size:13px;opacity:.75;margin-left:7px}.edit-card-placeholder{font-size:12px;line-height:1.6;opacity:.75}
  .edit-card-action{display:grid;place-items:center;width:40px;height:40px;min-width:40px;padding:0;border:0;border-radius:50%;background:var(--edit-action,#62052e);color:var(--edit-action-label,#fff)}.edit-card-action:disabled{opacity:.45;cursor:not-allowed}.edit-card-form{margin:0}.edit-card-action svg{width:22px;height:22px}
  .edit-card-swatches{display:flex;gap:6px;align-items:center;flex-wrap:wrap;padding:22px 22px 0;margin-top:auto}.edit-swatch{display:block;width:26px;height:26px;padding:3px;border:1px solid transparent;border-radius:7px}.edit-swatch[aria-current=true]{border-color:currentColor}.edit-swatch>span,.edit-swatch>img{display:block;width:100%;height:100%;border-radius:4px;background:var(--swatch-color,transparent);object-fit:cover}.edit-swatch .edit-swatch-text{display:grid;place-items:center;font-size:9px;border:1px solid currentColor}.edit-swatch-more{font-size:11px;padding:4px}
  @media(max-width:760px){.product-edit-grid{grid-template-columns:repeat(var(--edit-mobile-columns,2),minmax(0,1fr))}.edit-card-body{padding:12px 14px 0;gap:8px}.edit-card h3{font-size:15px}.edit-card-action{width:36px;height:36px;min-width:36px}.edit-card-swatches{padding:18px 14px 0}.edit-card-media .beauty-object{scale:.5}.edit-badge{top:10px;left:10px;font-size:10px;padding:4px 8px}}
{% endstylesheet %}
{% schema %}
{
  "name": "t:product_edit.name",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.slideshow.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.slideshow.heading",
      "default": "Your beauty favorites"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:product_edit.collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "t:product_edit.products",
      "info": "t:product_edit.products_info",
      "limit": 12
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "t:product_edit.product_limit",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:product_edit.columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:product_edit.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_swatches",
      "label": "t:product_edit.show_swatches",
      "default": true
    },
    {
      "type": "text",
      "id": "new_tag",
      "label": "t:product_edit.new_tag",
      "default": "new"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:product_edit.card_radius",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 20,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:product_edit.card_background",
      "default": "#FAF3F5"
    },
    {
      "type": "color",
      "id": "card_foreground",
      "label": "t:product_edit.card_foreground",
      "default": "#650D33"
    },
    {
      "type": "color",
      "id": "action_background",
      "label": "t:product_edit.action_background",
      "default": "#62052E"
    },
    {
      "type": "color",
      "id": "action_foreground",
      "label": "t:product_edit.action_foreground",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "t:editor.section_gap",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:product_edit.name"
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}

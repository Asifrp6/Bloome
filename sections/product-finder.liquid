{% render 'section-settings', section: section %}
<div class="bl-section bl-component-product-finder">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <form action="{{ routes.search_url }}" method="get" class="bl-finder">
    <input type="hidden" name="type" value="product">
    <div class="bl-grid" style="--columns:3">
      <div>
        <label for="FinderType-{{ section.id }}">{{ section.settings.type_label | escape }}</label
        ><select id="FinderType-{{ section.id }}" name="filter.p.product_type">
          <option value="">{{ 'library.any' | t }}</option>
          {% assign finder_types = section.settings.types | split: ',' -%}
          {%- for item in finder_types %}
            <option value="{{ item | strip | escape }}">{{ item | strip | escape }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label for="FinderTag-{{ section.id }}">{{ section.settings.tag_label | escape }}</label
        ><select id="FinderTag-{{ section.id }}" name="q">
          <option value="*">{{ 'library.any' | t }}</option>
          {% assign finder_tags = section.settings.tags | split: ',' -%}
          {%- for item in finder_tags %}
            <option value="tag:{{ item | strip | escape }}">{{ item | strip | escape }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label for="FinderPrice-{{ section.id }}">{{ 'library.budget' | t }}</label
        ><input
          id="FinderPrice-{{ section.id }}"
          name="filter.v.price.lte"
          type="number"
          min="0"
          step="0.01"
          placeholder="{{ 'library.no_limit' | t }}"
        >
      </div>
    </div>
    <button class="button" type="submit">{{ section.settings.button | escape }} &#8599;</button>
  </form>
</div>
{% stylesheet %}

  .bl-finder {
    padding: 35px;
    background: var(--color-surface);
  }
  .bl-finder label {
    display: block;
    font-size: 12px;
    margin-bottom: 10px;
  }
  .bl-finder select,
  .bl-finder input {
    width: 100%;
    min-height: 46px;
  }
  .bl-finder > .button {
    margin-top: 25px;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.product_finder.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.product_finder.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.product_finder.heading",
      "default": "Find your everyday match."
    },
    {
      "type": "text",
      "id": "type_label",
      "label": "t:library.product_finder.type_label",
      "default": "What are you looking for?"
    },
    {
      "type": "text",
      "id": "types",
      "label": "t:library.product_finder.types",
      "default": "Serum,Moisturizer,Lip tint"
    },
    {
      "type": "text",
      "id": "tag_label",
      "label": "t:library.product_finder.tag_label",
      "default": "Your preferred finish"
    },
    {
      "type": "text",
      "id": "tags",
      "label": "t:library.product_finder.tags",
      "default": "Dewy,Matte,Natural"
    },
    {
      "type": "text",
      "id": "button",
      "label": "t:library.product_finder.button",
      "default": "Find my essentials"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "t:editor.section_gap",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "presets": [
    {
      "name": "t:library.product_finder.name"
    }
  ]
}
{% endschema %}

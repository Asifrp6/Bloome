{% render 'section-settings', section: section %}
<div class="bl-section">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <bloome-recommendations
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&amp;product_id={{ product.id }}&amp;limit=4&amp;intent={{ section.settings.intent }}"
    {% if recommendations.performed? %}
      data-loaded
    {% endif %}
    {% if product == blank %}
      data-loaded
    {% endif %}
  >
    {% if recommendations.performed? %}
      <div class="bl-products">
        {% for card_product in recommendations.products -%}
          {%- render 'beauty-card', card_product: card_product, index: forloop.index -%}
        {%- endfor %}
      </div>
    {% elsif product == blank %}
      <div class="bl-products">
        {% for i in (1..4) -%}
          {%- render 'beauty-card', index: i -%}
        {%- endfor %}
      </div>
    {% else %}
      <a class="text-link" href="{{ routes.all_products_collection_url }}">
        {{- 'bloome.shop_all' | t }} &#8599;</a
      >
    {% endif %}
  </bloome-recommendations>
</div>
{% javascript %}
  class BloomeRecommendations extends HTMLElement {
    connectedCallback() {
      if (this.hasAttribute('data-loaded') || this.observer) return;
      this.observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            this.observer.disconnect();
            this.load();
          }
        },
        { rootMargin: '300px' },
      );
      this.observer.observe(this);
    }
    async load() {
      try {
        const response = await fetch(this.dataset.url);
        if (!response.ok) return;
        const html = new DOMParser().parseFromString(await response.text(), 'text/html');
        const content = html.querySelector('bloome-recommendations');
        if (content?.querySelector('.beauty-card')) {
          this.replaceChildren(...content.childNodes);
          this.setAttribute('data-loaded', '');
        } else this.closest('.shopify-section').hidden = true;
      } catch {}
    }
    disconnectedCallback() {
      this.observer?.disconnect();
    }
  }
  if (!customElements.get('bloome-recommendations'))
    customElements.define('bloome-recommendations', BloomeRecommendations);
{% endjavascript %}
{% schema %}

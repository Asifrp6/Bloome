{% render 'section-settings', section: section %}
<div class="bl-section bl-component-promo-grid">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-grid" style="--columns:{{ section.settings.columns }}">
    {% for block in section.blocks %}
      <article class="bl-tile" {{ block.shopify_attributes }}>
        {% render 'library-media', image: block.settings.image, index: forloop.index %}
        <div class="bl-copy">
          <h3>{{ block.settings.title | escape }}</h3>
          <div class="bl-rte">{{ block.settings.text }}</div>
          {% if block.settings.button != blank -%}
            <a class="button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
              {{- block.settings.button | escape }}
              <span aria-hidden="true">&#8599;</span></a
            >
          {%- endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</div>
{% schema %}
{
  "name": "t:library.promo_grid.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.promo_grid.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.promo_grid.heading",
      "default": "Something for every shelf."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:library.promo_grid.columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "t:editor.section_gap",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "tile",
      "name": "t:library.promo_grid.block_0",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:library.promo_grid.b0_image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:library.promo_grid.b0_title",
          "default": "A new discovery"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:library.promo_grid.b0_text",
          "default": "<p>A curated edit of everyday essentials.</p>"
        },
        {
          "type": "text",
          "id": "button",
          "label": "t:library.promo_grid.b0_button",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:library.promo_grid.b0_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:library.promo_grid.name",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "title": "The skincare edit"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "A little colour"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Gifts, thoughtfully chosen"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% render 'section-settings', section: section %}
<div class="bl-section bl-component-shop-by-price" style="--price-card-background:{{ section.settings.card_background }};--price-card-foreground:{{ section.settings.card_foreground }};--price-card-radius:{{ section.settings.card_radius }}px">
  {% render 'library-heading', eyebrow:section.settings.eyebrow, heading:section.settings.heading %}
  <div class="bl-grid price-card-grid" style="--columns:{{ section.settings.columns }};--mobile-columns:{{ section.settings.columns_mobile }}">
    {% for block in section.blocks %}
      {% assign maximum = block.settings.maximum | default:30 | at_least:0 %}
      {% assign currency_code = cart.currency.iso_code | default: shop.currency %}
      {% assign minor_units = 100 %}
      {% assign padded_currency = ' ' | append: currency_code | append: ' ' %}
      {% if ' BIF CLP DJF GNF ISK JPY KMF KRW PYG RWF UGX VND VUV XAF XOF XPF ' contains padded_currency %}
        {% assign minor_units = 1 %}
      {% elsif ' BHD IQD JOD KWD LYD OMR TND ' contains padded_currency %}
        {% assign minor_units = 1000 %}
      {% endif %}
      {% assign maximum_price = maximum | times: minor_units %}
      {% assign collection_url = block.settings.collection.url | default:routes.all_products_collection_url %}
      {% assign card_image = block.settings.image | default:block.settings.collection.featured_image %}
      <article class="price-category-card" {{ block.shopify_attributes }}>
        <a class="price-category-image" href="{{ collection_url }}?filter.v.price.lte={{ maximum | url_encode }}" aria-label="{{ block.settings.title | escape }} — {{ 'library.under_price' | t }} {{ maximum_price | money | escape }}">{% render 'library-media', image:card_image, index:forloop.index %}</a>
        <div class="price-category-body">
          <h3>{{ block.settings.title | default:block.settings.collection.title | escape }}</h3>
          {% if block.settings.description != blank %}<p class="price-category-description">{{ block.settings.description | escape }}</p>{% endif %}
          <div class="price-category-budget"><span>{{ 'library.under_price' | t }}</span><strong>{% if settings.show_currency_code %}{{ maximum_price | money_with_currency }}{% else %}{{ maximum_price | money_without_trailing_zeros }}{% endif %}</strong><span>{{ 'price_cards.only' | t }}</span></div>
          <a class="price-category-button" href="{{ collection_url }}?filter.v.price.lte={{ maximum | url_encode }}">{% if block.settings.button != blank %}{{ block.settings.button | escape }}{% else %}{{ 'bloome.shop_now' | t }}{% endif %}<span class="visually-hidden"> — {{ block.settings.title | escape }}</span></a>
        </div>
      </article>
    {% endfor %}
  </div>
</div>
{% stylesheet %}
  .price-card-grid{align-items:stretch}.price-category-card{display:flex;flex-direction:column;min-width:0;overflow:hidden;border-radius:var(--price-card-radius,20px);background:var(--price-card-background,#f2e0e5);color:var(--price-card-foreground,#762247)}
  .price-category-image{display:block;overflow:hidden}.price-category-image .bl-media{aspect-ratio:16/9;border-radius:0!important;background:var(--price-card-background)}.price-category-image img{transition:transform .35s ease}.price-category-image:hover img{transform:scale(1.035)}.price-category-image .beauty-object{scale:.5}
  .price-category-body{padding:24px clamp(18px,2.4vw,40px);text-align:center;display:flex;flex-direction:column;flex:1}.price-category-body h3{font-size:18px;font-weight:650;line-height:1.35;text-transform:uppercase;margin:0 0 7px;letter-spacing:.01em}.price-category-description{font-size:14px;line-height:1.6;margin-bottom:20px}
  .price-category-budget{margin-top:auto;padding-top:14px;border-top:1px solid color-mix(in srgb,currentColor 25%,transparent);display:flex;align-items:center;justify-content:center;gap:clamp(10px,1.6vw,28px);flex-wrap:wrap}.price-category-budget>span{font-size:12px;text-transform:uppercase;letter-spacing:.13em}.price-category-budget strong{font-size:44px;font-weight:650;line-height:1.25;letter-spacing:-.03em}
  .price-category-button{display:flex;justify-content:center;align-items:center;min-height:49px;border:1px solid currentColor;border-radius:999px;margin-top:20px;padding:12px;font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;transition:background .2s,color .2s}.price-category-button:hover{background:var(--price-card-foreground);color:var(--price-card-background)}
  @media(max-width:1000px) and (min-width:761px){.price-card-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.price-card-grid{grid-template-columns:repeat(var(--mobile-columns,1),minmax(0,1fr))}.price-category-body{padding:22px 20px}.price-category-body h3{font-size:16px}.price-category-budget{gap:12px}.price-category-budget strong{font-size:38px}}
  @media(prefers-reduced-motion:reduce){.price-category-image img,.price-category-button{transition:none}}
{% endstylesheet %}

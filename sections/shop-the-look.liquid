{% render 'section-settings', section: section %}
<div class="bl-section bl-component-shop-the-look">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-split">
    <div class="bl-hotspot-image">
      {% render 'library-media', image: section.settings.image -%}
      {%- for block in section.blocks %}
        <details
          class="bl-hotspot"
          style="--x:{{ block.settings.x }}%;--y:{{ block.settings.y }}%"
          {{ block.shopify_attributes }}
        >
          <summary aria-label="{{ block.settings.title | escape }}">{{ forloop.index }}</summary>
          <div>
            {% if block.settings.product != blank -%}
              <a href="{{ block.settings.product.url }}">
                {{- block.settings.product.title | escape -}}
                <br>
                {{ block.settings.product.price | money -}}
              </a>
            {%- else -%}
              {{- block.settings.title | escape -}}
            {%- endif %}
          </div>
        </details>
      {% endfor %}
    </div>
    <div class="bl-look-products">
      {% for block in section.blocks -%}
        {%- if block.settings.product != blank -%}
          {%- render 'beauty-card', card_product: block.settings.product, index: forloop.index -%}
        {%- else %}
          <p>{{ forloop.index }} / {{ block.settings.title | escape }}</p>
        {% endif -%}
      {%- endfor %}
    </div>
  </div>
</div>
{% stylesheet %}

  .bl-hotspot-image {
    position: relative;
  }
  .bl-hotspot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
  }
  .bl-hotspot summary {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fff8eb;
    box-shadow: 0 0 0 7px #ffffff55;
    cursor: pointer;
    list-style: none;
  }
  .bl-hotspot > div {
    position: absolute;
    top: 54px;
    left: 50%;
    transform: translateX(-50%);
    background: #fff8eb;
    padding: 15px;
    width: 180px;
    max-width: 45vw;
    box-shadow: 0 6px 20px #49323f33;
    font-size: 12px;
    z-index: 5;
  }
  .bl-hotspot[open] {
    z-index: 5;
  }
  .bl-look-products {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap:var(--grid-gap,20px);
  }
  .bl-look-products > p {
    padding: 20px;
    border-bottom: 1px solid var(--color-border);
    font-size: 14px;
  }

{% endstylesheet %}

{% render 'section-settings', section: section %}
<div class="bl-section bl-component-store-story">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-split">
    {% render 'library-media', image: section.settings.image %}
    <div class="bl-copy">
      <h3>{{ section.settings.title | escape }}</h3>
      <div class="bl-rte">{{ section.settings.text }}</div>
      <div class="bl-story-facts">
        {% for block in section.blocks %}
          <div {{ block.shopify_attributes }}>
            <strong>{{ block.settings.value | escape }}</strong>
            <p>{{ block.settings.title | escape }}</p>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.button != blank -%}
        <a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
          {{- section.settings.button | escape }}
          <span aria-hidden="true">&#8599;</span></a
        >
      {%- endif %}
    </div>
  </div>
</div>
{% stylesheet %}

  .bl-story-facts {
    display: flex;
    gap: 25px;
    flex-wrap: wrap;
    margin-top: 30px;
  }
  .bl-story-facts strong {
    font-family: Georgia, serif;
    font-size: 27px;
    font-weight: 400;
  }
  .bl-story-facts p {
    font-size: 11px;
    margin-top: 8px;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.store_story.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:library.store_story.eyebrow",
      "default": "The Bloome edit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:library.store_story.heading",
      "default": "A little more about us."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:library.store_story.image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:library.store_story.title",
      "default": "Made for the moments that are yours."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:library.store_story.text",
      "default": "<p>Thoughtful details, beautiful textures and room for your own kind of beauty. Explore the story behind Bloome.</p>"
    },
    {
      "type": "text",
      "id": "button",
      "label": "t:library.store_story.button",
      "default": "Explore our world"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:library.store_story.link"
    },
    {
      "type": "header",
      "content": "t:editor.section_design"
    },
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "t:editor.section_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "t:editor.content_width",
      "default": "page",
      "options": [
        {
          "value": "page",
          "label": "t:editor.content_width_0"
        },
        {
          "value": "narrow",
          "label": "t:editor.content_width_1"
        },
        {
          "value": "full",
          "label": "t:editor.content_width_2"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:editor.text_alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:editor.text_alignment_0"
        },
        {
          "value": "center",
          "label": "t:editor.text_alignment_1"
        },
        {
          "value": "right",
          "label": "t:editor.text_alignment_2"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "custom_typography",
      "label": "t:editor.custom_typography",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "t:editor.heading_size",
      "default": 46,
      "min": 24,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "heading_mobile_size",
      "label": "t:editor.heading_mobile_size",
      "default": 34,
      "min": 22,
      "max": 72,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_gap",
      "label": "t:editor.section_gap",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:editor.padding_top",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:editor.padding_bottom",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_top",
      "label": "t:editor.padding_mobile_top",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_mobile_bottom",
      "label": "t:editor.padding_mobile_bottom",
      "default": 30,
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:editor.section_visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_desktop",
      "label": "t:editor.hide_desktop",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_mobile",
      "label": "t:editor.hide_mobile",
      "default": false
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "fact",
      "name": "t:library.store_story.block_0",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "t:library.store_story.b0_value",
          "default": "Everyday"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:library.store_story.b0_title",
          "default": "A moment for you"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:library.store_story.name",
      "blocks": [
        {
          "type": "fact",
          "settings": {
            "value": "Your skin",
            "title": "Your ritual"
          }
        },
        {
          "type": "fact",
          "settings": {
            "value": "Your pace",
            "title": "Your everyday"
          }
        },
        {
          "type": "fact",
          "settings": {
            "value": "Your glow",
            "title": "Your kind of beautiful"
          }
        }
      ]
    }
  ]
}
{% endschema %}

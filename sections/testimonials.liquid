{% render 'section-settings', section: section %}
<div class="bl-section bl-component-testimonials">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-grid" style="--columns:{{ section.settings.columns }}">
    {% for block in section.blocks %}
      <figure class="bl-review" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank -%}
          {%- render 'library-media', image: block.settings.image -%}
        {%- endif %}
        <blockquote>{{ block.settings.quote | escape }}</blockquote>
        <figcaption>{{ block.settings.author | escape }}</figcaption>
        {% if block.settings.product != blank -%}
          <a class="text-link" href="{{ block.settings.product.url }}">
            {{- block.settings.product.title | escape -}}
          </a>
        {%- endif %}
      </figure>
    {% endfor %}
  </div>
</div>
{% stylesheet %}

  .bl-review {
    padding: 28px;
    background: var(--color-surface);
    margin: 0;
  }
  .bl-review blockquote {
    font-family: Georgia, serif;
    font-size: 25px;
    line-height: 1.4;
    margin: 10px 0 24px;
  }
  .bl-review figcaption {
    font-size: 12px;
    margin-bottom: 15px;
  }
  .bl-review .bl-media {
    margin-bottom: 25px;
  }

{% endstylesheet %}
{% schema %}
{
  "name": "t:library.testimonials.name",
  "tag": "section",
  "class": "bloome-library-section",
  "settings": [
    {

    {
      "type": "range",
      "id": "text_size",
      "label": "t:editor.text_size",
      "default": 14,
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.custom_typography }}"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "t:editor.image_radius",
      "default": 0,
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",

{% render 'section-settings', section: section %}
<div class="bl-section bl-component-video-gallery">
  {% render 'library-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading %}
  <div class="bl-scroll">
    {% for block in section.blocks %}
      <article {{ block.shopify_attributes }}>
        <div class="bl-video-card">
          {% if block.settings.video != blank -%}
            {{-
              block.settings.video
              | video_tag: controls: true, preload: 'none', image_size: '600x', playsinline: true
            -}}
          {%- else -%}
            {%- render 'library-media', image: block.settings.image, index: forloop.index -%}
            <span class="bl-video-mark" aria-hidden="true">&#9655;</span>
          {%- endif %}
        </div>
        <div class="bl-copy">
          <h3>{{ block.settings.title | escape }}</h3>
          {% if block.settings.product != blank -%}
            <a class="text-link" href="{{ block.settings.product.url }}">
              {{- block.settings.product.title | escape }} / {{ block.settings.product.price | money -}}
            </a>
          {%- endif %}
        </div>
      </article>
    {% endfor %}
  </div>
</div>
{% stylesheet %}

  .bl-video-card {
    position: relative;
    aspect-ratio: 0.7;
    overflow: hidden;
    background: #eaded6;
  }
  .bl-video-card > .bl-media,
  .bl-video-card > video {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    object-fit: cover;
  }
  .bl-video-mark {
    position: absolute;
    left: 20px;
    bottom: 20px;
    display: grid;
    place-items: center;
    width: 45px;
    height: 45px;
    background: #fff8eb;
    border-radius: 50%;
    font-size: 25px;
  }

{% endstylesheet %}

{% doc %}
  Renders a shared section heading and section library layout styles.

  @param {string} [eyebrow] - Short introductory text.
  @param {string} [heading] - Heading text.
{% enddoc %}
{% if eyebrow != blank or heading != blank %}<div class="bl-heading" style="display:block;width:100%;max-width:none">
  {% if eyebrow != blank %}
    <p class="eyebrow" style="max-width:none;overflow-wrap:normal;word-break:normal">{{ eyebrow | escape }}</p>
  {% endif -%}
  {%- if heading != blank %}
    <h2 style="display:block;width:100%;max-width:none;overflow-wrap:normal;word-break:normal;hyphens:none">{{ heading | escape }}</h2>
  {% endif %}
</div>{% endif %}
{% stylesheet %}

  .bl-section [hidden] {
    display: none !important;
  }
  .bl-section {
    min-width: 0;
    width: 100%;
    padding: 55px 0;
    color: var(--color-foreground, #49323f);
  }
  .bl-heading {
    width: 100%;
    max-width: none;
    margin-bottom: 30px;
  }
  .bl-heading .eyebrow {
    margin-bottom: 12px;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }
  .bl-heading h2 {
    max-width: none;
    font-size: clamp(30px, 3.6vw, 50px);
    font-weight: 400;
    letter-spacing: -0.055em;
    line-height: 1.1;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
    text-wrap: wrap;
  }
  .bl-grid {
    display: grid;
    grid-template-columns: repeat(var(--columns, 3), minmax(0, 1fr));
    gap: 22px;
  }
  .bl-media {
    display: grid;
    place-items: center;
    aspect-ratio: var(--ratio, 1);
    background: var(--color-surface);
    overflow: hidden;
    position: relative;
  }
  .bl-media > img,
  .bl-media > video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .bl-media .beauty-object {
    scale: 0.8;
  }
  .bl-media--2 {
    background: #e8dce0;
  }
  .bl-media--3 {
    background: #dfe3d4;
  }
  .bl-copy {
    padding: 28px 0;
  }
  .bl-copy h3,
  .bl-tile h3 {
    font-size: 23px;
    font-weight: 400;
    letter-spacing: -0.035em;
    margin-bottom: 12px;
  }
  .bl-copy p,
  .bl-rte {
    font-size: 14px;
    line-height: 1.8;
  }
  .bl-rte p + p {
    margin-top: 12px;
  }
  .bl-copy .button {
    margin-top: 24px;
  }
  .bl-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 50px;
  }
  .bl-split > *,
  .bl-grid > * {
    min-width: 0;
  }
  .bl-tile > h3 {
    margin-top: 18px;
  }
  .bl-tile > p {
    font-size: 12px;
    line-height: 1.7;
  }
  .bl-tabs {
    display: flex;
    gap: 12px;
    margin-bottom: 25px;
    overflow-x: auto;
    padding: 5px;
  }
  .bl-tabs button {
    white-space: nowrap;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    border-radius: 30px;
    padding: 12px 20px;
    font-size: 12px;
  }
  .bl-tabs button[aria-selected='true'] {
    background: #49323f;
    color: #fff8eb;
    border-color:var(--color-foreground);
  }
  .bl-panel[hidden] {
    display: none;
  }
  .bl-muted {
    font-size: 12px;
    color: color-mix(in srgb,var(--color-foreground) 75%,transparent);
    line-height: 1.7;
  }
  .bl-center {
    text-align: center;
  }
  .bl-center .bl-rte {
    max-width: 650px;
    margin: auto;
  }
  .bl-center .button {
    margin-top: 25px;
  }
  .bl-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap:var(--grid-gap,20px);
  }
  .bl-scroll {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 1fr);
    gap: 22px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 15px;
  }
  .bl-scroll > * {
    scroll-snap-align: start;
  }
  .bl-swatch {
    width: 22px;
    height: 22px;
    border: 1px solid #b8a9ad;
    border-radius: 50%;
    display: inline-block;
    background: var(--swatch);
  }
  .bl-prose h3 {
    margin: 18px 0 8px;
  }
  .bl-prose p {
    line-height: 1.8;
  }
  .bl-control {
    min-height: 44px;
    min-width: 44px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: inherit;
    padding: 10px;
  }
  .bl-controls {
    display: flex;
    gap: 10px;
    justify-content: end;
    margin-top: 18px;
  }
  @media (max-width: 760px) {
    .bl-section {
      padding: 35px 0;
    }
    .bl-grid {
      grid-template-columns: repeat(var(--mobile-columns, 1), minmax(0, 1fr));
      gap: 24px 14px;
    }
    .bl-split {
      grid-template-columns: 1fr;
      gap:var(--grid-gap,20px);
    }
    .bl-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 25px 12px;
    }
    .bl-media .beauty-object {
      scale: 0.65;
    }
    .bl-copy {
      padding: 10px 0;
    }
    .bl-scroll {
      grid-auto-columns: 80%;
    }
  }

{% endstylesheet %}
{% javascript %}
  class BloomeTabs extends HTMLElement {
    connectedCallback() {
      if (this.ready) { if(this.lookMedia){this.lookMedia.addEventListener('change',this.lookLayout);this.lookLayout();} return; }
      this.ready = true;
      this.tabs = [...this.querySelectorAll('[role=tab]')];
      if(this.classList.contains('look-showcase')){this.lookMedia=matchMedia('(max-width:760px)');this.lookLayout=()=>this.querySelector('[role=tablist]').setAttribute('aria-orientation',this.lookMedia.matches?'horizontal':'vertical');this.lookMedia.addEventListener('change',this.lookLayout);this.lookLayout();}
      this.addEventListener('click', (e) => {
        const tab = e.target.closest('[role=tab]');
        if (tab) this.activate(tab);
        const preview=e.target.closest('[data-look-index]');if(preview){const target=this.tabs[Number(preview.dataset.lookIndex)];if(target){this.activate(target);target.focus({preventScroll:true});}}
      });
      this.addEventListener('keydown', (e) => {
        const i = this.tabs.indexOf(e.target);
        if (i < 0) return;
        let next;
        if (e.key === 'ArrowRight') next = (i + 1) % this.tabs.length;
        if (e.key === 'ArrowLeft') next = (i - 1 + this.tabs.length) % this.tabs.length;
        if(this.classList.contains('look-showcase')){if(e.key==='ArrowDown')next=(i+1)%this.tabs.length;if(e.key==='ArrowUp')next=(i-1+this.tabs.length)%this.tabs.length;}
        if (e.key === 'Home') next = 0;
        if (e.key === 'End') next = this.tabs.length - 1;
        if (next !== undefined) {
          e.preventDefault();
          this.activate(this.tabs[next]);
          this.tabs[next].focus();
        }
      });
      this.blockSelect = (e) => {
        const panel = e.target.closest('[role=tabpanel]');
        if (panel) {
          const tab = this.tabs.find((t) => t.getAttribute('aria-controls') === panel.id);
          if (tab) this.activate(tab);
        }
      };
      this.addEventListener('shopify:block:select',this.blockSelect);
    }
    disconnectedCallback(){this.lookMedia?.removeEventListener('change',this.lookLayout);}
    activate(tab) {
      this.tabs.forEach((t) => {
        const active = t === tab;
        t.setAttribute('aria-selected', String(active));
        t.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls'));
        if (panel) panel.hidden = !active;
      });
    }
  }
  if (!customElements.get('bloome-tabs')) customElements.define('bloome-tabs', BloomeTabs);

  class BloomeCountdown extends HTMLElement {
    connectedCallback() {
      if (this.interval) return;
      const end = Date.parse(this.dataset.end);
      const tick = () => {
        const delta = end - Date.now();
        if (!Number.isFinite(end) || delta <= 0) {
          this.querySelector('[role=timer]').hidden = true;
          this.querySelector('[data-expired]').hidden = false;
          clearInterval(this.interval);
          return;
        }
        const seconds = Math.floor(delta / 1000);
        for (const [key, value] of Object.entries({
          days: Math.floor(seconds / 86400),
          hours: Math.floor(seconds / 3600) % 24,
          minutes: Math.floor(seconds / 60) % 60,
          seconds: seconds % 60,
        }))
          this.querySelector('[data-' + key + ']').textContent = String(value).padStart(2, '0');
      };
      tick();
      if (Number.isFinite(end) && end > Date.now()) this.interval = setInterval(tick, 1000);
    }
    disconnectedCallback() {
      clearInterval(this.interval);
      this.interval = null;
    }
  }
  if (!customElements.get('bloome-countdown')) customElements.define('bloome-countdown', BloomeCountdown);
{% endjavascript %}

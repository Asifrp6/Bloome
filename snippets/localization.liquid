{% doc %}
  Renders configured country and language choices.
  @param {string} id - Unique form identifier
{% enddoc %}
{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
{% form 'localization', id: id, class: 'bloome-localization' %}
{% if localization.available_countries.size > 1 %}<label for="Country-{{ id }}">{{ 'editor.country' | t }}</label><select id="Country-{{ id }}" name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}" {% if country.iso_code == localization.country.iso_code %}selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code }})</option>{% endfor %}</select>{% endif %}
{% if localization.available_languages.size > 1 %}<label for="Language-{{ id }}">{{ 'editor.language' | t }}</label><select id="Language-{{ id }}" name="language_code">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}" {% if language.iso_code == localization.language.iso_code %}selected{% endif %}>{{ language.endonym_name | escape }}</option>{% endfor %}</select>{% endif %}
<button class="button" type="submit">{{ 'editor.update_region' | t }}</button>
{% endform %}{% endif %}
{% stylesheet %}.bloome-localization{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-top:24px;font-size:12px}.bloome-localization select{max-width:100%}{% endstylesheet %}
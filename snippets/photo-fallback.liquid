{% doc %}
  Real photograph shown until a merchant image is chosen.
  @param {number} [index] - Chooses which photograph to show.
  @param {string} [loading] - Image loading strategy.
  @param {string} [priority] - Fetch priority for the image.
  @param {string} [image_class] - Extra class names for the image.
{% enddoc %}
{% liquid
  assign photo_slot = index | default: 1 | modulo: 12
  if photo_slot == 0
    assign photo_slot = 12
  endif
  case photo_slot
    when 2
      assign photo_file = 'bloome-2.jpg'
      assign photo_width = 1200
      assign photo_height = 1512
    when 3
      assign photo_file = 'bloome-3.jpg'
      assign photo_width = 1400
      assign photo_height = 933
    when 4
      assign photo_file = 'bloome-4.jpg'
      assign photo_width = 1400
      assign photo_height = 2098
    when 5
      assign photo_file = 'bloome-5.jpg'
      assign photo_width = 1400
      assign photo_height = 1400
    when 6
      assign photo_file = 'bloome-6.jpg'
      assign photo_width = 1400
      assign photo_height = 948
    when 7
      assign photo_file = 'bloome-7.jpg'
      assign photo_width = 1000
      assign photo_height = 667
    when 8
      assign photo_file = 'bloome-8.jpg'
      assign photo_width = 1400
      assign photo_height = 2100
    when 9
      assign photo_file = 'bloome-9.jpg'
      assign photo_width = 1400
      assign photo_height = 933
    when 10
      assign photo_file = 'bloome-10.jpg'
      assign photo_width = 1400
      assign photo_height = 933
    when 11
      assign photo_file = 'bloome-11.jpg'
      assign photo_width = 1400
      assign photo_height = 2100
    when 12
      assign photo_file = 'bloome-12.jpg'
      assign photo_width = 1000
      assign photo_height = 665
    else
      assign photo_file = 'bloome-1.jpg'
      assign photo_width = 1600
      assign photo_height = 1067
  endcase
  assign photo_loading = loading | default: 'lazy'
  assign photo_priority = priority | default: 'auto'
  assign photo_class = 'photo-fallback'
  if image_class != blank
    assign photo_class = photo_class | append: ' ' | append: image_class
  endif
%}
<img
  class="{{ photo_class }}"
  src="{{ photo_file | asset_url }}"
  alt=""
  width="{{ photo_width }}"
  height="{{ photo_height }}"
  loading="{{ photo_loading }}"
  fetchpriority="{{ photo_priority }}"
>
{% stylesheet %}
  .photo-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

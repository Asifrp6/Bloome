{% doc %}
  Renders an accessible product or variant price, including sale and unit prices.
  @param {product} item - The priced resource.
{% enddoc %}
<span class="card-price">{% if item.compare_at_price > item.price %}<span class="visually-hidden">{{ 'editor.regular_price' | t }}</span><del>{% if settings.show_currency_code %}{{ item.compare_at_price | money_with_currency }}{% else %}{{ item.compare_at_price | money }}{% endif %}</del><span class="visually-hidden">{{ 'editor.sale_price' | t }}</span>{% endif %}{% if settings.show_currency_code %}{{ item.price | money_with_currency }}{% else %}{{ item.price | money }}{% endif %}</span>{% if item.unit_price_measurement %}<span class="unit-price">{{ item.unit_price | unit_price_with_measurement: item.unit_price_measurement }}</span>{% endif %}
{% doc %}
  Renders search filters while preserving search terms.
  @param {section} section - Owning section for field IDs
{% enddoc %}
      <form action="{{ routes.search_url }}" method="get" class="bl-filters"><input type="hidden" name="q" value="{{ search.terms | escape }}">
        <h2>{{ 'library.filters' | t }}</h2>
        {% for filter in search.filters %}
          <details open>
            <summary>{{ filter.label | escape }}</summary>
            {% case filter.type -%}
              {%- when 'list', 'boolean' -%}
                {%- for value in filter.values -%}
                  <label class="bl-filter-check"
                    ><input
                      type="checkbox"
                      name="{{ value.param_name }}"
                      value="{{ value.value | escape }}"
                      {% if value.active %}
                        checked
                      {% endif %}
                      {% if value.count == 0 %}
                        {%- unless value.active %}disabled{% endunless -%}
                      {% endif %}
                    >
                    {{- value.label | escape }} ({{ value.count }})</label
                  >
                {%- endfor -%}
              {%- when 'price_range' -%}
                <label for="FilterMin-{{ section.id }}">{{ 'library.minimum_price' | t }}</label
                ><input
                  id="FilterMin-{{ section.id }}"
                  name="{{ filter.min_value.param_name }}"
                  type="number"
                  min="0"
                  step="0.01"
                  {% if filter.min_value.value %}
                    value="{{ filter.min_value.value | divided_by:100.0 }}"
                  {% endif %}

                ><label for="FilterMax-{{ section.id }}">{{ 'library.maximum_price' | t }}</label
                ><input
                  id="FilterMax-{{ section.id }}"
                  name="{{ filter.max_value.param_name }}"
                  type="number"
                  min="0"
                  step="0.01"
                  {% if filter.max_value.value %}
                    value="{{ filter.max_value.value | divided_by:100.0 }}"
                  {% endif %}
                >
            {%- endcase %}
          </details>
        {% endfor -%}
        <label for="Sort-{{ section.id }}">{{ 'library.sort_by' | t }}</label
        ><select id="Sort-{{ section.id }}" name="sort_by">
          {% assign current_sort = search.sort_by | default: search.default_sort_by -%}
          {%- for option in search.sort_options %}
            <option
              value="{{ option.value }}"
              {% if option.value == current_sort %}
                selected
              {% endif %}
            >
              {{ option.name | escape }}
            </option>
          {% endfor %}</select
        ><button type="submit" class="button">{{ 'library.apply_filters' | t }}</button
        ><a class="text-link" href="{{ routes.search_url }}?q={{ search.terms | url_encode }}">{{ 'library.clear_filters' | t }}</a>
      </form>
{% stylesheet %}.bloome-search .bl-filters{display:flex;flex-wrap:wrap;align-items:start;gap:20px;padding-block:20px}.bloome-search .bl-filters details{max-width:250px}.bloome-search .bl-filters label{display:block;font-size:13px;margin-block:10px}{% endstylesheet %}
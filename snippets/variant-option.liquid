{% doc %}
  Renders one variant choice for the product purchase form.
  @param {variant} variant - Variant to render
  @param {variant} current_variant - Variant selected on page load
{% enddoc %}
{%- capture selling_plans -%}[{% for allocation in variant.selling_plan_allocations %}{"id":{{ allocation.selling_plan.id | json }},"name":{{ allocation.selling_plan.name | json }},"price":{{ allocation.price | money | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]{%- endcapture -%}
<option
  value="{{ variant.id }}"
  data-price="{% if settings.show_currency_code %}{{ variant.price | money_with_currency | escape }}{% else %}{{ variant.price | money | escape }}{% endif %}"
  data-compare="{% if variant.compare_at_price > variant.price %}{% if settings.show_currency_code %}{{ variant.compare_at_price | money_with_currency | escape }}{% else %}{{ variant.compare_at_price | money | escape }}{% endif %}{% endif %}"
  data-unit="{% if variant.unit_price_measurement %}{{ variant.unit_price | unit_price_with_measurement: variant.unit_price_measurement | escape }}{% endif %}"
  data-options="{{ variant.options | json | escape }}"
  data-available="{{ variant.available }}"
  data-sku="{{ variant.sku | escape }}"
  data-media="{{ variant.featured_media.id }}"
  data-plans="{{ selling_plans | escape }}"
  {% if variant.id == current_variant.id %}selected{% endif %}
>{{ variant.title | escape }} / {% if settings.show_currency_code %}{{ variant.price | money_with_currency }}{% else %}{{ variant.price | money }}{% endif %}{% unless variant.available %} / {{ 'bloome.sold' | t }}{% endunless %}</option>
